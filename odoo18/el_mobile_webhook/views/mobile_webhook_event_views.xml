<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_webhook_event_list" model="ir.ui.view">
        <field name="name">mobile.webhook.event.list</field>
        <field name="model">mobile.webhook.event</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'sent'" decoration-danger="state == 'failed'" decoration-warning="state == 'retrying'">
                <field name="event_uuid"/><field name="event_type"/><field name="record_name"/><field name="company_id"/><field name="state"/><field name="attempts"/><field name="next_attempt_at"/><field name="sent_at"/>
            </list>
        </field>
    </record>
    <record id="view_mobile_webhook_event_form" model="ir.ui.view">
        <field name="name">mobile.webhook.event.form</field>
        <field name="model">mobile.webhook.event</field>
        <field name="arch" type="xml">
            <form create="0" delete="0"><header>
                <button name="action_send_now" type="object" string="Send Now" invisible="state not in ('pending', 'retrying')"/>
                <button name="action_retry" type="object" string="Retry" invisible="state not in ('failed', 'cancelled')"/>
                <button name="action_cancel" type="object" string="Cancel" invisible="state in ('sent', 'cancelled')"/>
                <field name="state" widget="statusbar" statusbar_visible="pending,retrying,sent,failed,cancelled"/>
            </header><sheet><group><group><field name="event_uuid"/><field name="event_type"/><field name="record_name"/><field name="company_id"/><field name="previous_status"/><field name="status"/></group><group><field name="attempts"/><field name="next_attempt_at"/><field name="sent_at"/><field name="last_error"/></group></group><notebook><page string="Payload"><field name="payload_json" nolabel="1" readonly="1"/></page></notebook></sheet></form>
        </field>
    </record>
    <record id="view_mobile_webhook_event_search" model="ir.ui.view"><field name="name">mobile.webhook.event.search</field><field name="model">mobile.webhook.event</field><field name="arch" type="xml"><search><field name="event_uuid"/><field name="event_type"/><filter string="Pending" name="pending" domain="[('state', 'in', ('pending', 'retrying'))]"/><filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/></search></field></record>
    <record id="action_mobile_webhook_event" model="ir.actions.act_window"><field name="name">Webhook Events</field><field name="res_model">mobile.webhook.event</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_mobile_webhook_root" name="Mobile Webhook" groups="base.group_system" sequence="90"/>
    <menuitem id="menu_mobile_webhook_events" name="Events" parent="menu_mobile_webhook_root" action="action_mobile_webhook_event" groups="base.group_system" sequence="10"/>
</odoo>
