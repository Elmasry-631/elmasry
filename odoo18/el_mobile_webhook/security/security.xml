<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mobile_webhook" model="ir.module.category">
        <field name="name">Mobile Webhook</field>
    </record>
    <record id="group_mobile_webhook_manager" model="res.groups">
        <field name="name">Mobile Webhook Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_mobile_webhook_event_company" model="ir.rule">
        <field name="name">Mobile webhook event multi-company</field>
        <field name="model_id" ref="model_mobile_webhook_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
