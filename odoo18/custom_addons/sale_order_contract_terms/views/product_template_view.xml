<odoo>
    <record id="technical_specification_field" model="ir.ui.view">
        <field name="name">product.template.technical.specification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_policy']" position="after">
                <field name="technical_specification"/>
            </xpath>
        </field>
    </record>
        <record id="technical_specification_field_order_line" model="ir.ui.view">
        <field name="name">product.template.technical.specification.order.line</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="technical_specification_id"/>
            </xpath>
        </field>
    </record>
</odoo>