<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_transaction_form_inherit" model="ir.ui.view">
        <field name="name">payment.transaction.form.inherit.down_payment</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='transaction_details']" position="inside">
                <field name="original_order_amount" invisible="provider_code != 'paymob'"/>
                <field name="transaction_amount" invisible="provider_code != 'paymob'"/>
                <field name="down_payment" invisible="provider_code != 'paymob'"/>
                <field name="discount" invisible="provider_code != 'paymob'"/>
                <field name="shopify_payment_id" invisible="provider_code != 'paymob'"/>
            </xpath>
        </field>
    </record>
</odoo>
