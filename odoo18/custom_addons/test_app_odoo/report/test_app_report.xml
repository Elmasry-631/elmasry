<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="test_report_app" model="ir.actions.report">
        <field name="name">test report</field>
        <field name="model">test.app.odoo</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_test_app_odoo"/>
        <field name="binding_type">report</field>
        <field name="report_name">test_app_odoo.test_app_report_template</field>
    </record>


    <template id="test_app_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <t t-foreach="docs" t-as="o">
                    <h1>Test Report</h1>
                    <style>
                        table {
                        width:100%;
                        padding:2px;
                        }
                        table th {
                        color:333;
                        }
                    </style>
                    <table>
                        <thead>
                            <th colspan="4">General Information</th>
                        </thead>
                        <tbody>
                            <td>name</td>
                            <td>test</td>
                            <td>Postcode</td>
                            <td>test</td>
                        </tbody>
                    </table>
                </t>
            </t>
        </t>
    </template>
</odoo>