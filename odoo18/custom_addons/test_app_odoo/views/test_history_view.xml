        <field name="name">Test history</field>
        <field name="model">test.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="user_id"/>
                <field name="property_id"/>
                <field name="old_state"/>
                <field name="new_state"/>
            </list>
        </field>
    </record>
