        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="old_state"/>
                            <field name="new_state"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
