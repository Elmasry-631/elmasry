<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_warehouse_access_matrix" model="ir.actions.act_window">
        <field name="name">Warehouse Access Matrix</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('share', '=', False), ('active', '=', True)]</field>
        <field name="context">{
            'search_default_with_warehouse': 1,
            'default_show_warehouse_info': True
        }</field>
        <field name="limit">80</field>
    </record>

    <record id="view_warehouse_access_pivot" model="ir.ui.view">
        <field name="name">warehouse.access.pivot</field>
        <field name="model">res.users</field>
        <field name="type">pivot</field>
        <field name="arch" type="xml">
            <pivot string="Warehouse Access Matrix">
                <field name="name" type="row"/>
                <field name="warehouse_ids" type="measure"/>
            </pivot>
        </field>
    </record>

    <menuitem id="menu_warehouse_access_root"
              name="Warehouse Access Control"
              parent="stock.menu_stock_config_settings"
              sequence="100"
              groups="el_warehouse_access.group_warehouse_manager"/>

    <menuitem id="menu_warehouse_user_assignment"
              name="User Warehouse Assignments"
              parent="menu_warehouse_access_root"
              action="base.action_res_users"
              sequence="10"
              groups="el_warehouse_access.group_warehouse_manager"/>

    <menuitem id="menu_warehouse_access_report"
              name="Warehouse Access Matrix"
              parent="menu_warehouse_access_root"
              action="action_warehouse_access_matrix"
              sequence="20"
              groups="el_warehouse_access.group_warehouse_manager"/>

</odoo>
