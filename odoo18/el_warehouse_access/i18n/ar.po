#. module: el_warehouse_access
#, python-format
msgid "Cannot create move: You don't have access to this warehouse."
msgstr "لا يمكن إنشاء حركة: ليس لديك صلاحية للوصول إلى هذا المستودع."

#. module: el_warehouse_access
#, python-format
msgid "Cannot create inventory quantity at location '%s'. You don't have access to this location/warehouse."
msgstr "لا يمكن إنشاء كمية مخزن في الموقع '%s'. ليس لديك صلاحية للوصول إلى هذا الموقع/المستودع."

#. module: el_warehouse_access
#, python-format
msgid "Cannot create inventory adjustment for this location. You don't have access to it."
msgstr "لا يمكن إنشاء تعديل جرد لهذا الموقع. ليس لديك صلاحية للوصول إليه."

#. module: el_warehouse_access
#, python-format
msgid "Cannot create scrap at location '%s'. You don't have access to this location/warehouse."
msgstr "لا يمكن إنشاء تالف في الموقع '%s'. ليس لديك صلاحية للوصول إلى هذا الموقع/المستودع."

#. module: el_warehouse_access
#, python-format
msgid "Cannot start inventory '%s' - you don't have access to some of its locations: %s"
msgstr "لا يمكن بدء الجرد '%s' - ليس لديك صلاحية للوصول إلى بعض مواقعه: %s"

#. module: el_warehouse_access
#, python-format
msgid "Cannot validate scrap '%s' - you don't have access to its location '%s'."
msgstr "لا يمكن اعتماد التالف '%s' - ليس لديك صلاحية للوصول إلى موقعه '%s'."

#. module: el_warehouse_access
#, python-format
msgid "You are selecting an operation type from warehouse '%s' which you don't have access to. You may not be able to save this record."
msgstr "أنت تختار نوع عملية من المستودع '%s' الذي ليس لديك صلاحية للوصول إليه. قد لا تتمكن من حفظ هذا السجل."

#. module: el_warehouse_access
#, python-format
msgid "You are selecting a picking type outside your warehouses."
msgstr "أنت تختار نوع استلام خارج مستودعاتك."

#. module: el_warehouse_access
#, python-format
msgid "You don't have access to location '%s'. You may not be able to validate this record."
msgstr "ليس لديك صلاحية للوصول إلى الموقع '%s'. قد لا تتمكن من اعتماد هذا السجل."

