#. module: el_warehouse_access
#, python-format
msgid "You cannot create a transfer in warehouse '%s'. You don't have access to this warehouse."
msgstr "لا يمكنك إنشاء نقل في المستودع '%s'. ليس لديك صلاحية للوصول إلى هذا المستودع."

#. module: el_warehouse_access
#, python-format
