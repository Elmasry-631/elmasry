<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        el_restrict_journal — record rules (WHITELIST mode)
        
        WHITELIST semantics (opposite of blacklist):
          * User in group_restrict_journal_user can ONLY see/use journals
            in their allowed_journal_ids list.
          * Journals NOT in the list are COMPLETELY HIDDEN
            (perm_read=False, perm_write=False, perm_create=False, perm_unlink=False).
        
        Only ONE rule per model (not two like blacklist mode):
          * Rule: domain = [('journal_id', 'in', user.allowed_journal_ids.ids)]
            perms = RWCUD
          * This rule alone hides everything not in the allowed list.
        
        Empty allowed_journal_ids handling:
          * If user is in the group BUT has empty allowed_journal_ids,
            they see NO journals. This is why the Python override
            auto-removes users from the group when their list is cleared.
        
        Admin (is_admin=True) bypasses all record rules — always sees everything.
    -->

    <!-- ===== account.journal ===== -->
    <record id="rule_journal_allowed_only" model="ir.rule">
        <field name="name">Restrict Journal: only show allowed journals</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="domain_force">[('id', 'in', user.allowed_journal_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_restrict_journal_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <!-- ===== account.move ===== -->
    <record id="rule_move_allowed_only" model="ir.rule">
        <field name="name">Restrict Journal: only show moves in allowed journals</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('journal_id', 'in', user.allowed_journal_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_restrict_journal_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <!-- ===== account.payment ===== -->
    <record id="rule_payment_allowed_only" model="ir.rule">
        <field name="name">Restrict Journal: only show payments in allowed journals</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="domain_force">[('journal_id', 'in', user.allowed_journal_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_restrict_journal_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
