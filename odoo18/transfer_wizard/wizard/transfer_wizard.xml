<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="transfer_wizard_form_view" model="ir.ui.view">
            <field name="name">transfer.wizard.form</field>
            <field name="model">transfer.wizard</field>
            <field name="arch" type="xml">
                <form string="Transfer">
                    <group>
                        <field name="expected_weight" readonly="1"/>
                        <field name="driver_name" string="اسم السائق"/>
                        <field name="car_number" string="رقم السيارة"/>
                    </group>
                    <footer>
                        <button name="validate" type="object" string="Validate"
                                class="btn-primary"
                                confirm="Are you sure?"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="server_action_open_transfer_wizard" model="ir.actions.server">
            <field name="name">Transfer Trade</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
        action = {
            "type": "ir.actions.act_window",
            "res_model": "transfer.wizard",
            "view_mode": "form",
            "view_id": env.ref("transfer_wizard.transfer_wizard_form_view").id,
            "target": "new",
            "context": env.context,   # مهم جدا علشان active_ids
        }
            </field>
        </record>
    </data>
</odoo>