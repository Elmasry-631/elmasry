<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_investment_club_list" model="ir.ui.view">
        <field name="name">investment.club.list</field>
        <field name="model">investment.club</field>
        <field name="arch" type="xml">
            <list decoration-success="is_active == True" decoration-muted="is_active == False">
                <field name="code"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="active_members_count"/>
                <field name="max_members"/>
                <field name="administrative_fees" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="view_investment_club_form" model="ir.ui.view">
        <field name="name">investment.club.form</field>
        <field name="model">investment.club</field>
        <field name="arch" type="xml">
            <form>
              <header>
                    <button name="toggle_active" type="object" 
                            string="Activate" 
                            invisible="is_active == True"
                            class="btn-success"/>
                    <button name="toggle_active" type="object" 
                            string="Deactivate" 
                            invisible="is_active == False"
                            class="btn-warning"/>
                    <field name="is_active" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name_ar" placeholder="Arabic Club Name"/>
                        </h2>
                        <h3>
                            <field name="name_en" placeholder="Club Name in English"/>
                        </h3>
                    </div>
                    
                    <group>
                        <group string="Club Info">
                            <field name="is_active"/>
                            <field name="max_members"/>
                            <field name="active_members_count"/>
                            <field name="current_members_count"/>
                        </group>
                        <group string="Fees">
                            <field name="administrative_fees" widget="monetary"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Projects">
                            <field name="project_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="analytic_account_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Members">
                            <field name="member_ids">
                                <list>
                                    <field name="membership_number"/>
                                    <field name="partner_id"/>
                                    <field name="investor_code"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Conditions">
                            <field name="terms_conditions" placeholder="Enter the club terms and conditions here..."/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_investment_club_search" model="ir.ui.view">
        <field name="name">investment.club.search</field>
        <field name="model">investment.club</field>
        <field name="arch" type="xml">
            <search>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="code"/>
                <filter string="Active Clubs" name="is_active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive Clubs" name="not_active" domain="[('is_active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_investment_club" model="ir.actions.act_window">
        <field name="name">Investment Clubs</field>
        <field name="res_model">investment.club</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new investment club
            </p>
            <p>
                Investment clubs group investors together for collective investment projects.
                Each club can have multiple projects and members.
            </p>
        </field>
    </record>

</odoo>
