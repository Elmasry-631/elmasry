<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_return_payment_ledger_pdf" model="ir.actions.report">
        <field name="name">Return Payment Ledger</field>
        <field name="model">investment.actual.return</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">investment_club.return_payment_ledger</field>
        <field name="report_file">investment_club.return_payment_ledger</field>
        <field name="print_report_name">'Return Payment Ledger'</field>
        <field name="binding_model_id" ref="model_investment_actual_return"/>
        <field name="binding_type">report</field>
    </record>

    <template id="return_payment_ledger">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2>Return payment ledger</h2>
                    <p>Return Payment Ledger Report</p>
                    <p>Generated: <span t-esc="date"/></p>
                    <table class="table table-sm table-bordered table-striped">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Investor</th>
                                <th>Membership Number</th>
                                <th>Project</th>
                                <th>Return Type</th>
                                <th>Period</th>
                                <th>Expected</th>
                                <th>Actual</th>
                                <th>Difference</th>
                                <th>Payment Status</th>
                                <th>Payment Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data" t-as="line">
                                <td><span t-esc="line['investor']"/></td>
                                <td><span t-esc="line['membership_number']"/></td>
                                <td><span t-esc="line['project']"/></td>
                                <td><span t-esc="line['return_type']"/></td>
                                <td><span t-esc="line['period']"/></td>
                                <td><span t-esc="line['expected_amount']"/></td>
                                <td><span t-esc="line['actual_amount']"/></td>
                                <td><span t-esc="line['difference']"/></td>
                                <td><span t-esc="line['state']"/></td>
                                <td><span t-esc="line['payment_date']"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="bg-light font-weight-bold">
                                <td colspan="5">Total / Grand Total</td>
                                <td><span t-esc="total_expected"/></td>
                                <td><span t-esc="total_actual"/></td>
                                <td><span t-esc="total_difference"/></td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                    <br/>
                    <p><strong>Number Details / Total Records:</strong> <span t-esc="count"/></p>
                </div>
            </t>
        </t>
    </template>
</odoo>
