<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_all_picking">
        <t t-call="web.html_container">
            <div class="page">
                <t t-foreach="docs[0]" t-as="o">
                    <t t-call="web.internal_layout">
                        <table class="table  table-bordered table-sm">
                            <thead>
                                <tr>
                                                                        <th>مستند المصدر</th>

                                    <th>السائق</th>
                                    <th>رقم الشاحنة</th>
                                    <th>اجمالي الوزن</th>
                                    <t t-if="o.neighborhood_id">
                                        <th>الحي</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                  <td>
                                        <span t-field="o.origin"/>
                                    </td>
                                <td>
                                    <span t-field="o.driver_name.name"/>
                                </td>
                                <td>
                                    <span t-field="o.car_number"/>
                                </td>
                                <td>
                                    <t t-set="total_weight" t-value="sum(int(doc.total_weight) for doc in docs)"/>
                                    <span t-esc="total_weight"/>
                                </td>
                                <t t-if="o.neighborhood_id">
                                    <td>
                                        <span t-field="o.neighborhood_id.name"/>
                                    </td>
                                </t>
                            </tbody>
                        </table>
                        <!-- get unique locations for all products -->
                        <t t-set="locations_outer" t-value="[]"/>
                        <t t-set="product_lst" t-value="[]"/>
                        <t t-foreach="docs" t-as="o">
                            <t t-foreach="o.move_ids_without_package" t-as="move">
                                <t t-set="product_lst" t-value="product_lst + [move.product_id]"/>
                            </t>
                        </t>
                        <t t-set="locations" t-value="set(request.env['stock.quant'].sudo().search([], order='location_id desc'))"/>
                        <t t-foreach="locations" t-as="loc">
                            <t t-foreach="set(product_lst)" t-as="product">
                                <t t-set="loc_obj"
                                   t-value="request.env['stock.quant'].sudo().search([('product_id', '=', product.id),
                                   ('location_id.usage','=', 'internal')], order='id desc', limit=1)"/>
                                <t t-if="loc_obj.id == loc.id">
                                    <t t-set="locations_outer" t-value="locations_outer + [loc_obj.location_id]"/>
                                </t>
                            </t>
                        </t>
                        <t t-foreach="list(set(locations_outer))" t-as="loc_outer">
                            <strong style="text-align:center;"> المخزن :  </strong>
                            <strong style="text-align:center;" t-esc="loc_outer.name" />
                            <table class="table  table-bordered table-sm" t-if="o.move_line_ids"
                               style="border: 2px solid black;" dir="rtl">
                            <t t-set="has_barcode"
                               t-value="any([move_ids_without_package.product_id and move_ids_without_package.product_id.sudo().barcode or move_ids_without_package.package_id for move_ids_without_package in o.move_line_ids])"/>
                            <t t-set="has_serial_number"
                               t-value="o.move_line_ids.filtered(lambda ml: ml.lot_id or ml.lot_name)"
                               groups="stock.group_production_lot"/>
                            <thead>
                                <tr>
                                    <th style="border: 2px solid black;text-align:center;">
                                        <strong style="text-align:center;">م</strong>
                                    </th>
                                    <th style="border: 2px solid black;text-align:center;">
                                        <strong style="text-align:center;">الوزن</strong>
                                    </th>
                                    <th style="border: 2px solid black;text-align:center;">
                                        <strong style="text-align:center;">الصنف</strong>
                                    </th>
                                    <th style="border: 2px solid black;text-align:center;">
                                        <strong style="text-align:center;">المخزن</strong>
                                    </th>

                                    <th style="border: 2px solid black;text-align:center;">
                                        <strong style="text-align:center;">الكمية</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="item_number" t-value="1"/>
                                <t t-set="product_lst" t-value="[]"/>
                                <t t-foreach="docs" t-as="o">
                                    <t t-foreach="o.move_ids_without_package" t-as="move">
                                        <t t-set="product_lst" t-value="product_lst + [move.product_id]"/>
                                    </t>
                                </t>
                                <t t-set="locations" t-value="set(request.env['stock.quant'].sudo().search([]))"/>
                                <t t-foreach="locations" t-as="loc">
                                    <t t-foreach="set(product_lst)" t-as="product">
                                        <t t-set="loc_obj"
                                           t-value="request.env['stock.quant'].sudo().search([('product_id', '=', product.id),
                                           ('location_id.usage','=', 'internal')], order='id desc', limit=1)"/>
                                        <t t-if="loc_obj.id == loc.id and loc.location_id.id == loc_outer.id">
                                            <tr>
                                                <t t-set="qty_total" t-value="0"/>
                                                <t t-set="weight_total" t-value="0"/>
                                                <t t-foreach="docs" t-as="o">
                                                    <t t-foreach="o.move_ids_without_package" t-as="move">
                                                        <t t-if="move.product_id.id == product.id">
                                                            <t t-set="weight_total"
                                                               t-value="weight_total+(product.weight*move.product_uom_qty)"/>
                                                            <t t-set="qty_total"
                                                               t-value="qty_total+move.product_uom_qty"/>
                                                        </t>
                                                    </t>
                                                </t>
                                                <!--      Item Number                                         -->
                                                <td style="border: 2px solid black;text-align:center;">
                                                    <span t-esc="item_number" style="text-align:center;"/>
                                                    <t t-set="item_number" t-value="item_number+1"/>
                                                    <br/>
                                                </td>
                                                <!--       wight                                         -->
                                                <td style="border: 2px solid black;text-align:center;">
                                                    <span t-esc="weight_total" style="text-align:center;"/>
                                                </td>
                                                <!--       Product Name                                         -->
                                                <td style="border: 2px solid black;text-align:center;">
                                                    <span t-field="product.display_name" style="text-align:center;"/>
                                                    <br/>
                                                </td>
                                                <!--       Location                                         -->
                                                <td style="border: 2px solid black;text-align:center;">
                                                    <span t-esc="loc.location_id.name"
                                                          style="text-align:center;"/>

                                                </td>
                                                <!--       Quantity                                       -->
                                                <td style="border: 2px solid black;text-align:center;">
                                                    <span style="text-align:center;" t-esc="int(qty_total)"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                        </t>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <report
            string="طباعة اذون الصرف"
            id="action_report_all_picking"
            model="stock.picking"
            report_type="qweb-pdf"
            name="trade_paints_features.report_all_picking"
            file="trade_paints_features.report_all_picking_operations"
    />
</odoo>
