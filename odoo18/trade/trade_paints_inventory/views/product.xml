<odoo>
  <data>
        <record id="product_category_form_view_inherit_trade_paint" model="ir.ui.view">
            <field name="name">product.category.form</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view" />
            <field name="arch" type="xml">
                <group name="first" position="after">
                    <group>
                        <field name="limit_discount"/>
                    </group>
                </group>
            </field>
        </record>

        <record model="ir.ui.view" id="product_template_tradepaints_tree_view">
            <field name="name">product.template.tradepaints.tree</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <field name="qty_available" position="after">
                    <field name="current_qty_value"/>
                    <field name="weight"/>
                </field>
            </field>
        </record>
      <record id="product_template_only_form_view_inherited1" model="ir.ui.view">
            <field name="name">product.template.form.inherited1</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
<!--                <field name="seller_ids" position="attributes">-->
<!--                    <attribute name="invisible">1</attribute>-->
<!--                </field>-->
                 <xpath expr="//group[@name='group_standard_price']" position="after">
                     <button name="change_price" string="change_values" type="object"/>
                 </xpath>
                 <xpath expr="//group[@name='group_standard_price']" position="after">
                     <group for="seller_ids" string="Vendors"/>
                     <field name="seller_ids" />
                 </xpath>
        </field>
  </record>
  </data>
</odoo>