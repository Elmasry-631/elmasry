    <!-- ================= Product Template ================= -->
    <record id="product_template_form_options" model="ir.ui.view">
        <field name="name">product_template_form_options</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">false</attribute>
            </form>
        </field>
    </record>

    <record id="product_template_tree_options" model="ir.ui.view">
        <field name="name">product_template_tree_options</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">false</attribute>
            </list>
        </field>
    </record>

    <!-- ================= Product Product ================= -->
    <record id="product_product_form_options" model="ir.ui.view">
        <field name="name">product_product_form_options</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">false</attribute>
            </form>
        </field>
    </record>

    <record id="product_product_tree_options" model="ir.ui.view">
        <field name="name">product_product_tree_options</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">false</attribute>
            </list>
        </field>
    </record>

