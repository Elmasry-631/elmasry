<odoo>

    <!-- ================= Sale Order ================= -->
    <record id="sale_order_partner_options" model="ir.ui.view">
        <field name="name">sale_order_partner_options</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- منع create/edit للـ Partner -->
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
            <!-- منع create/edit للـ Products في order lines -->
            <field name="order_line" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
        </field>
    </record>

    <!-- ================= Purchase Order ================= -->
    <record id="purchase_order_partner_options" model="ir.ui.view">
        <field name="name">purchase_order_partner_options</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
            <field name="order_line" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
        </field>
    </record>

    <!-- ================= Invoice ================= -->
    <record id="invoice_partner_options" model="ir.ui.view">
        <field name="name">invoice_partner_options</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
            <field name="invoice_line_ids" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
        </field>
    </record>

    <!-- ================= Stock Picking ================= -->
    <record id="stock_picking_partner_options" model="ir.ui.view">
        <field name="name">stock_picking_partner_options</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
        </field>
    </record>

