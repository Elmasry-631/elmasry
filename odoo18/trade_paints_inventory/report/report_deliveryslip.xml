<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document_inheited" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@class='page']//h2" position="after">
            <h4 t-if="o.driver_name">
                <span>Driver  : </span>
                <span t-field="o.driver_name"/>
            </h4>
            <h4 t-if="o.car_number">
                <span>Car number : </span>
                <span t-field="o.car_number"/>
            </h4>
        </xpath>
    </template>
</odoo>