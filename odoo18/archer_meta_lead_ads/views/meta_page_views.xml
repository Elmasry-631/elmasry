<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_page_list" model="ir.ui.view">
        <field name="name">meta.page.list</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="credential_id"/>
                <field name="platform" widget="badge"/>
                <field name="category"/>
                <field name="form_count"/>
                <field name="lead_count"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_meta_page_form" model="ir.ui.view">
        <field name="name">meta.page.form</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <form string="Meta Page">
                <header>
                    <button name="action_fetch_forms" type="object" string="Fetch Forms" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_forms" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="form_count" widget="statinfo" string="Forms"/>
                        </button>
                        <button name="action_view_leads" type="object" class="oe_stat_button" icon="fa-user-plus">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="credential_id"/>
                            <field name="page_id"/>
                            <field name="platform" widget="badge"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="instagram_account_id" invisible="not instagram_account_id"/>
                            <field name="fan_count"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Forms">
                            <field name="form_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="crm_team_id"/>
                                    <field name="mapping_count"/>
                                    <field name="lead_count"/>
                                    <field name="last_fetch_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meta_page_search" model="ir.ui.view">
        <field name="name">meta.page.search</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_facebook" string="Facebook" domain="[('platform', '=', 'facebook')]"/>
                <filter name="filter_instagram" string="Instagram / Both" domain="[('platform', 'in', ('instagram', 'both'))]"/>
                <filter name="filter_active" string="Active" domain="[('is_active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_credential" string="Credential" context="{'group_by': 'credential_id'}"/>
                    <filter name="group_platform" string="Platform" context="{'group_by': 'platform'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meta_page" model="ir.actions.act_window">
        <field name="name">Pages</field>
        <field name="res_model">meta.page</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_page_search"/>
    </record>
</odoo>
