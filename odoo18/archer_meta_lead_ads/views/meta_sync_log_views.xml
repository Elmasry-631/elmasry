<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_sync_log_list" model="ir.ui.view">
        <field name="name">meta.sync.log.list</field>
        <field name="model">meta.sync.log</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="create_date"/>
                <field name="level" widget="badge"/>
                <field name="category"/>
                <field name="credential_id"/>
                <field name="page_id"/>
                <field name="form_id"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_meta_sync_log_form" model="ir.ui.view">
        <field name="name">meta.sync.log.form</field>
        <field name="model">meta.sync.log</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="level" readonly="1"/>
                            <field name="category" readonly="1"/>
                            <field name="credential_id" readonly="1"/>
                            <field name="page_id" readonly="1"/>
                            <field name="form_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="message" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meta_sync_log_search" model="ir.ui.view">
        <field name="name">meta.sync.log.search</field>
        <field name="model">meta.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <filter name="filter_warning" string="Warnings" domain="[('level', '=', 'warning')]"/>
                <filter name="filter_error" string="Errors" domain="[('level', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_credential" string="Credential" context="{'group_by': 'credential_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meta_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Issues</field>
        <field name="res_model">meta.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_sync_log_search"/>
        <field name="context">{'search_default_filter_error': 1}</field>
    </record>
</odoo>
