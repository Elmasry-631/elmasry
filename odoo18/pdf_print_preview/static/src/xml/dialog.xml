<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pdf_print_preview.PDFPreviewDialog">
        <Dialog title="props.title" size="'xl'">
            <div class="o_pdf_preview_dialog">
                <iframe t-ref="iframe"
                        style="width:100%; height:80vh; border:0"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
