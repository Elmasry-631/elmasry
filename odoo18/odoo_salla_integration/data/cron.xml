<odoo>
	<data noupdate="1">
		<record id="cron_resync_salla_under_review_orders" forcecreate="True" model="ir.cron">
			<field name="name">Salla - Resync Stalled Orders</field>
			<field name="active" eval="False"/>
			<field name="user_id" ref="base.user_root"/>
			<field name="interval_number">2</field>
			<field name="interval_type">hours</field>
			<field name="model_id" ref="odoo_multi_channel_sale.model_multi_channel_sale"/>
			<field name="state">code</field>
			<field name="code">model.cron_resync_salla_under_review_orders()</field>
		</record>
		<record id="cron_salla_sweep_updated_orders" forcecreate="True" model="ir.cron">
			<field name="name">Salla - Sweep Recently Updated Orders</field>
			<field name="active" eval="True"/>
			<field name="user_id" ref="base.user_root"/>
			<field name="interval_number">30</field>
			<field name="interval_type">minutes</field>
			<field name="model_id" ref="odoo_multi_channel_sale.model_multi_channel_sale"/>
			<field name="state">code</field>
			<field name="code">model.cron_salla_sweep_updated_orders()</field>
		</record>
		<record id="cron_salla_order_backfill" forcecreate="True" model="ir.cron">
			<field name="name">Salla - Order Backfill (date range, chunked)</field>
			<field name="active" eval="True"/>
			<field name="user_id" ref="base.user_root"/>
			<field name="interval_number">5</field>
			<field name="interval_type">minutes</field>
			<field name="model_id" ref="model_salla_order_backfill"/>
			<field name="state">code</field>
			<field name="code">model.cron_process()</field>
		</record>
		<record id="cron_salla_order_audit" forcecreate="True" model="ir.cron">
			<field name="name">Salla - Order Audit (list and compare)</field>
			<field name="active" eval="True"/>
			<field name="user_id" ref="base.user_root"/>
			<field name="interval_number">5</field>
			<field name="interval_type">minutes</field>
			<field name="model_id" ref="model_salla_order_audit"/>
			<field name="state">code</field>
			<field name="code">model.cron_process()</field>
		</record>
	</data>
	<!-- Apply interval on upgrade (noupdate create above would leave old 6h on existing DBs). -->
	<data>
		<record id="cron_resync_salla_under_review_orders" model="ir.cron">
			<field name="interval_number">2</field>
			<field name="interval_type">hours</field>
		</record>
	</data>
</odoo>
