<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="salla_order_backfill_view_list" model="ir.ui.view">
		<field name="name">salla.order.backfill.list</field>
		<field name="model">salla.order.backfill</field>
		<field name="arch" type="xml">
			<list string="Salla Order Backfills">
				<field name="name"/>
				<field name="channel_id"/>
				<field name="date_from"/>
				<field name="date_to"/>
				<field name="total_count"/>
				<field name="done_count"/>
				<field name="failed_count"/>
				<field name="progress" widget="progressbar"/>
				<field name="last_run"/>
				<field name="state" widget="badge" decoration-info="state == 'running'" decoration-success="state == 'done'"/>
			</list>
		</field>
	</record>

	<record id="salla_order_backfill_view_form" model="ir.ui.view">
		<field name="name">salla.order.backfill.form</field>
		<field name="model">salla.order.backfill</field>
		<field name="arch" type="xml">
			<form string="Salla Order Backfill">
				<header>
					<button name="action_start" type="object" string="Start" class="btn-primary" invisible="state == 'running'"/>
					<button name="action_run_now" type="object" string="Run Now" invisible="state != 'running'"/>
					<button name="action_retry_failed" type="object" string="Retry Failed" invisible="failed_count == 0"/>
					<button name="action_reset" type="object" string="Reset" invisible="state == 'draft'" confirm="Reset the counters of this backfill?"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" readonly="1"/></h1>
					</div>
					<group>
						<group>
							<field name="channel_id" readonly="state != 'draft'"/>
							<field name="date_from" readonly="state != 'draft'"/>
							<field name="date_to" readonly="state != 'draft'"/>
						</group>
						<group>
							<field name="total_count"/>
							<field name="done_count"/>
							<field name="remaining_count"/>
							<field name="failed_count"/>
							<field name="progress" widget="progressbar"/>
							<field name="last_run"/>
						</group>
					</group>
					<group string="Failed store order ids" invisible="failed_count == 0">
						<field name="failed_ids_display" nolabel="1" readonly="1"/>
					</group>
					<group string="Last error" invisible="not last_error">
						<field name="last_error" nolabel="1" readonly="1"/>
					</group>
					<div class="text-muted">
						Orders of the range are imported by the scheduled action "Salla - Order Backfill" every 5 minutes,
						10 orders per call, and the import resumes where it stopped. "Run Now" processes one batch immediately.
					</div>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_salla_order_backfill" model="ir.actions.act_window">
		<field name="name">Salla Order Backfill</field>
		<field name="res_model">salla.order.backfill</field>
		<field name="view_mode">list,form</field>
	</record>

	<menuitem id="menu_salla_order_backfill"
			  name="Salla Order Backfill"
			  parent="odoo_multi_channel_sale.menu_miscellaneous"
			  action="action_salla_order_backfill"
			  sequence="3"/>
</odoo>
