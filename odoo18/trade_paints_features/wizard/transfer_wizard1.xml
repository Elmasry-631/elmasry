<?xml version="1.0"?>
<odoo>
      <record id="transfer_wizard_view" model="ir.ui.view">
        <field name="name">transfer.wizard.form.view</field>
        <field name="model">transfer.wizard</field>
        <field name="arch" type="xml">
          <form string="">
            <group>
                  <field name="expected_weight" groups="trade_paints_features.trade_paint_expected_weight"/>
                  <field name="driver_name" string="اسم السائق" />
                  <field name="car_number" string="رقم السيارة "/>
            </group>
            <footer>
              <button name="validate" string="Validate" type="object" class="oe_highlight"
              confirm="Are you sure ?"/>
              or
              <button string="Cancel" class="oe_link" special="cancel"/>
            </footer>
            </form>
        </field>
      </record>

      <act_window id="open_transfer_wizard_action_1"
                  name="Transfer Trade1"
                  src_model="stock.picking"
                  res_model="transfer.wizard"
                  view_mode="form"
                  target="new"
                  key2="client_action_multi"/>
</odoo>