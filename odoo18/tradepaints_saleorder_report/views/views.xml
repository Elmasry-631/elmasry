<odoo>
  <data>
  <template id="external_layout_build0">
    <t t-if="not o and doc">
        <t t-set="o" t-value="doc"/>
    </t>
    <t t-if="o and 'company_id' in o">
        <t t-set="company" t-value="o.company_id"></t>
    </t>
    <t t-if="not o or not 'company_id' in o">
        <t t-set="company" t-value="res_company"></t>
    </t>

    <t t-call="tradepaints_saleorder_report.external_layout_header0" />
    <t t-raw="0" />
    <t t-call="tradepaints_saleorder_report.external_layout_footer0" />
</template>

 <template id="external_layout_header0">
<!--    <t t-set="doc" t-value="doc.with_context({'lang':user.lang})"/>-->
    <div class="header text-right">
        <div class="row">
        </div>
    </div>
</template>

<template id="external_layout_footer0">
    <div class="footer">

    </div>
</template>





  </data>
</odoo>