<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <template id="report_all_picking2">
            <t t-call="web.html_container">
                <div class="page">

                    <t t-call="web.internal_layout">


                         <table class="table  table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>مستند المصدر</th>
                                    <th>السائق</th>
                                    <th>رقم الشاحنة</th>
                                    <th>اجمالي الوزن</th>
                                    <t t-if="doc_number1.neighborhood_id">
                                        <th>الحي</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                  <td>
                                    <span t-field="doc_number1.origin"/>
                                </td>
                                <td>
                                    <span t-field="doc_number1.driver_name.name"/>
                                </td>
                                <td>
                                    <span t-field="doc_number1.car_number"/>
                                </td>
                                <td>
                                    <span t-esc="weight_total"/>
                                </td>
                                <t t-if="doc_number1.neighborhood_id">
                                    <td>
                                        <span t-field="doc_number1.neighborhood_id.name"/>
                                    </td>
                                </t>
                            </tbody>
                        </table>



                        <table class="table table-sm o_main_table" style="border: 2px solid black;" dir="rtl">
                            <thead>
                                <tr>
                                    <th style="border: 2px solid black;text-align:center;" class="text-center">م</th>
                                    <th style="border: 2px solid black;text-align:center;"  class="text-center">الوزن</th>
                                    <th style="border: 2px solid black;text-align:center;"  class="text-center">الصنف</th>
                                    <th style="border: 2px solid black;text-align:center;" class="text-center">المخزن</th>
                                    <th style="border: 2px solid black;text-align:center;" class="text-center">الكمية</th>

                                </tr>
                            </thead>
                            <tbody class="sale_tbody">
                                <t t-foreach="locations" t-as="location">
                                    <t t-set="item_number" t-value="0"/>
                                    <tr style="background-image: linear-gradient(to bottom, #fcfcfc, #dedede);background-color:#ededed ;height:5px;">
                                        <td></td>
                                        <td></td>
                                        <td><span t-esc="get_location_name(location)" style="font-size: 25px;" class="text-center"/></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr t-foreach="lines" t-as="line">
                                        <t t-if="location == line.get('location_id')">
                                             <t t-set="item_number" t-value="item_number+1"/>

                                             <td  style="border: 2px solid black;text-align:center;" class="text-center">
                                                <span t-esc="item_number"/>
                                            </td>

                                            <td  style="border: 2px solid black;text-align:center;" class="text-center">
                                                <t t-if="line.get('weight')">
                                                    <span t-esc="line.get('qty') * line.get('weight')"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="line.get('qty') * 0.0"/>
                                                </t>
                                            </td>

                                            <td  style="border: 2px solid black;text-align:center;" class="text-center">
<!--                                                <span t-esc="line.get('product_name')"/>-->
                                                <span t-esc="request.env['product.product'].search([('id','=',line.get('product_id'))],limit=1).product_tmpl_id.name"/>
                                            </td>
                                            <td style="border: 2px solid black;text-align:center;" class="text-center">
                                                <span t-esc="line.get('location_name')"/>
                                            </td>
                                            <td style="border: 2px solid black;text-align:center;"  class="text-center">
                                                <span t-esc="int(line.get('qty'))"/>
                                            </td>

                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                    </t></div>
            </t>
        </template>
    </data>
</odoo>
