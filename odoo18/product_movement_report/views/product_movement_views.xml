<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard -->
    <record id="product_movement_wizard_form" model="ir.ui.view">
        <field name="name">product.movement.wizard.form</field>
        <field name="model">product.movement.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Movement Report">
                <group>
                    <group>
                        <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="lot_id" options="{'no_create': True, 'no_open': True}"
                               invisible="not product_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_show" type="object" string="View Report"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_print" type="object" string="Print PDF"
                            class="btn-secondary" data-hotkey="p"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_movement_wizard" model="ir.actions.act_window">
        <field name="name">Product Movement Report</field>
        <field name="res_model">product.movement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Result list -->
    <record id="product_movement_line_list" model="ir.ui.view">
        <field name="name">product.movement.line.list</field>
        <field name="model">product.movement.line</field>
        <field name="arch" type="xml">
            <list string="Product Movements" create="0" edit="0" delete="0"
                  decoration-success="qty_in &gt; 0"
                  decoration-danger="qty_out &gt; 0"
                  decoration-muted="qty_in == 0 and qty_out == 0"
                  decoration-bf="is_sold_out">
                <field name="cycle_no" optional="hide"/>
                <field name="date"/>
                <field name="reference"/>
                <field name="move_type"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="partner_id" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="origin" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="qty_in" sum="Total In"/>
                <field name="qty_out" sum="Total Out"/>
                <field name="balance"/>
                <field name="uom_id" optional="hide"/>
                <field name="is_sold_out" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="product_movement_line_search" model="ir.ui.view">
        <field name="name">product.movement.line.search</field>
        <field name="model">product.movement.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <filter name="f_in" string="In" domain="[('qty_in', '&gt;', 0)]"/>
                <filter name="f_out" string="Out" domain="[('qty_out', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_cycle" string="Cycle" context="{'group_by': 'cycle_no'}"/>
                    <filter name="g_type" string="Movement Type" context="{'group_by': 'move_type'}"/>
                    <filter name="g_lot" string="Lot/Serial" context="{'group_by': 'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="product_movement_summary_list" model="ir.ui.view">
        <field name="name">product.movement.summary.list</field>
        <field name="model">product.movement.summary</field>
        <field name="arch" type="xml">
            <list string="Movement Summary" create="0" edit="0" delete="0">
                <field name="sequence" column_invisible="True"/>
                <field name="name" string="Stage"/>
                <field name="qty" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="is_bold" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="product_movement_wizard_result_form" model="ir.ui.view">
        <field name="name">product.movement.wizard.result.form</field>
        <field name="model">product.movement.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Movement Report">
                <group>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="lot_id" readonly="1"/>
                        <field name="currency_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Summary">
                        <group>
                            <group>
                                <field name="sales_revenue" string="Sales Revenue"/>
                                <field name="sales_cogs" string="Cost of Goods Sold"/>
                            </group>
                            <group>
                                <field name="margin" string="Margin"/>
                                <field name="margin_pct" string="Margin %"/>
                            </group>
                        </group>
                        <field name="summary_ids" nolabel="1" readonly="1"
                               context="{'create': False, 'edit': False, 'delete': False}"/>
                    </page>
                    <page string="Movements">
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list string="Product Movements" create="0" edit="0" delete="0"
                                  decoration-success="qty_in &gt; 0"
                                  decoration-danger="qty_out &gt; 0"
                                  decoration-muted="qty_in == 0 and qty_out == 0"
                                  decoration-bf="is_sold_out">
                                <field name="sequence" column_invisible="True"/>
                                <field name="cycle_no" optional="hide"/>
                                <field name="date"/>
                                <field name="reference"/>
                                <field name="move_type" string="Movement Type"
                                       optional="hide"/>
                                <field name="location_id"/>
                                <field name="location_dest_id"/>
                                <field name="partner_id" optional="show"/>
                                <field name="lot_id" optional="show"/>
                                <field name="origin" optional="hide"/>
                                <field name="user_id" optional="hide"/>
                                <field name="qty_in" sum="Total In"/>
                                <field name="qty_out" sum="Total Out"/>
                                <field name="balance"/>
                                <field name="cost" optional="show" sum="Total Cost"/>
                                <field name="uom_id" optional="hide"/>
                                <field name="is_sold_out" optional="hide"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_print" type="object" string="Print PDF"
                            class="btn-primary" data-hotkey="p"/>
                    <button name="action_show" type="object" string="Refresh Report"
                            class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_product_movement_report"
              name="Product Movement Lifecycle"
              parent="stock.menu_warehouse_report"
              action="action_product_movement_wizard"
              sequence="60"/>

</odoo>
