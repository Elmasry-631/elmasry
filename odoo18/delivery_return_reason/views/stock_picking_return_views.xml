<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_return_picking_form_inherit_reason" model="ir.ui.view">
        <field name="name">stock.return.picking.form.inherit.reason</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <field name="product_return_moves" position="before">
                <group>
                    <field name="x_return_reason_id" required="1"/>
                    <field name="x_return_note"/>
                </group>
            </field>
        </field>
    </record>
</odoo>
