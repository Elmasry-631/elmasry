<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_return_reason_tree" model="ir.ui.view">
        <field name="name">delivery.return.reason.tree</field>
        <field name="model">delivery.return.reason</field>
        <field name="arch" type="xml">
            <list string="أسباب رجوع التسليم" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_return_reason_form" model="ir.ui.view">
        <field name="name">delivery.return.reason.form</field>
        <field name="model">delivery.return.reason</field>
        <field name="arch" type="xml">
            <form string="سبب الرجوع">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_return_reason_search" model="ir.ui.view">
        <field name="name">delivery.return.reason.search</field>
        <field name="model">delivery.return.reason</field>
        <field name="arch" type="xml">
            <search string="بحث أسباب الرجوع">
                <field name="name"/>
                <separator/>
                <filter string="نشط" name="active" domain="[('active', '=', True)]"/>
                <filter string="غير نشط" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_delivery_return_reason" model="ir.actions.act_window">
        <field name="name">أسباب رجوع التسليم</field>
        <field name="res_model">delivery.return.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا توجد أسباب رجوع مسجلة
            </p>
            <p>
                أضف أسباب الرجوع التي يواجهها الدليفري عند عدم استلام العميل للطلب
            </p>
        </field>
    </record>

    <menuitem id="menu_delivery_return_root" name="أسباب الرجوع" parent="stock.menu_stock_root" sequence="90"/>
    <menuitem id="menu_delivery_return_reason_config" name="إدارة الأسباب" parent="menu_delivery_return_root" action="action_delivery_return_reason" sequence="10"/>

</odoo>