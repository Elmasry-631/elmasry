<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_return_pivot" model="ir.ui.view">
        <field name="name">stock.picking.return.pivot</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot string="تحليل أسباب الرجوع">
                <field name="x_return_reason_id" type="row"/>
                <field name="x_driver_name" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_picking_return_graph" model="ir.ui.view">
        <field name="name">stock.picking.return.graph</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <graph string="تحليل أسباب الرجوع" type="bar">
                <field name="x_return_reason_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_delivery_return_analysis" model="ir.actions.act_window">
        <field name="name">تحليل المرتجعات</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">pivot,graph,list</field>
        <!-- x_returned بيتفعّل من wizard الإرجاع فقط، فمفيش داعي لفلتر picking_type_code
             (المرتجع ممكن يتعمل incoming لو Return Type = Receipts) -->
        <field name="domain">[('x_returned', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا توجد عمليات رجوع مسجلة بعد
            </p>
            <p>
                قم بتسجيل أسباب رجوع الطلبات من شاشة التسليم لعرض التحليلات والإحصائيات هنا
            </p>
        </field>
    </record>

    <!-- ربط الـ views بالـ action صراحةً عشان ما يتاخدش view تاني من موديول آخر -->
    <record id="action_delivery_return_analysis_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_stock_picking_return_pivot"/>
        <field name="act_window_id" ref="action_delivery_return_analysis"/>
    </record>

    <record id="action_delivery_return_analysis_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_stock_picking_return_graph"/>
        <field name="act_window_id" ref="action_delivery_return_analysis"/>
    </record>

    <menuitem id="menu_delivery_return_analysis"
              name="تحليل المرتجعات"
              parent="menu_delivery_return_root"
              action="action_delivery_return_analysis"
              sequence="20"/>

</odoo>
