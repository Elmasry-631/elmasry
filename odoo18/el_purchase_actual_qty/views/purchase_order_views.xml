<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_actual_qty" model="ir.ui.view">
        <field name="name">purchase.order.form.actual.qty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="after">
                <field name="actual_qty" optional="show" readonly="state not in ('draft', 'sent')"/>
                <field name="variance_qty" optional="hide" readonly="1"/>
                <field name="variance_percent" optional="hide" readonly="1"/>
                <field name="effective_price_unit" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
