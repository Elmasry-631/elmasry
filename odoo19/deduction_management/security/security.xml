<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="deduction_management.module_category_deduction" model="ir.module.category">
            <field name="name">Deduction</field>
            <field name="sequence">11</field>
            <field name="visible" eval="True"/>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_deduction_management">
            <field name="name">Deduction Management</field>
            <field name="sequence">9</field>
            <field name="category_id" ref="deduction_management.module_category_deduction"/>
        </record>

        <record id="group_deduction_management_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="deduction_management.res_groups_privilege_deduction_management"/>
        </record>

        <record id="group_deduction_management_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="privilege_id" ref="deduction_management.res_groups_privilege_deduction_management"/>
        </record>

        <record id="group_deduction_management_hr" model="res.groups">
            <field name="name">HR</field>
            <field name="privilege_id" ref="deduction_management.res_groups_privilege_deduction_management"/>
        </record>

        <record id="group_deduction_management_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="deduction_management.res_groups_privilege_deduction_management"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="deduction_rule" model="ir.rule">
            <field name="name">Deduction rule</field>
            <field name="model_id" ref="model_deduction_deduction"/>
            <field name="groups" eval="[(4, ref('group_deduction_management_user')), (4, ref('group_deduction_management_approver'))]"/>
<!--            <field name="domain_force">['|', ('employee_id', 'in', user.employee_id.child_ids.ids),-->
<!--                ('employee_id.user_id', '=', user.id)]-->
<!--            </field>-->
            <field name="domain_force">
                [('employee_id', 'child_of', [user.employee_id.id])]
            </field>
        </record>

<!--        <record id="deduction_see_own_company" model="ir.rule">-->
<!--            <field name="name">Deductions: Only see deductions of own company</field>-->
<!--            <field name="model_id" ref="model_deduction_deduction"/>-->
<!--            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>-->
<!--            <field name="groups"-->
<!--                   eval="[(4, ref('group_deduction_management_manager')), (4, ref('group_deduction_management_hr'))]"/>-->
<!--        </record>-->
    </data>
</odoo>