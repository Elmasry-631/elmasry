<odoo>
    <record id="action_foodics_stock_reconciliation" model="ir.actions.act_window">
        <field name="name">Stock Reconciliation</field>
        <field name="res_model">foodics.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sync_type', '=', 'inventory')]</field>
        <field name="context">{'search_default_failed': 1}</field>
    </record>

    <menuitem id="menu_foodics_reports" name="Reports" parent="menu_foodics_root" sequence="40"/>
    <menuitem id="menu_foodics_stock_reconciliation" name="Stock Reconciliation" parent="menu_foodics_reports" action="action_foodics_stock_reconciliation" sequence="10"/>
</odoo>

