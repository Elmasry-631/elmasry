<odoo>
    <record id="view_foodics_test_connection_wizard_form" model="ir.ui.view">
        <field name="name">foodics.test.connection.wizard.form</field>
        <field name="model">foodics.test.connection.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="connection_id"/>
                    <field name="result" readonly="1"/>
                </group>
                <footer>
                    <button name="action_test" type="object" string="Test" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_foodics_test_connection_wizard" model="ir.actions.act_window">
        <field name="name">Test Foodics Connection</field>
        <field name="res_model">foodics.test.connection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

