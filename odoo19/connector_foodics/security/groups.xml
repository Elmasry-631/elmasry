<odoo>
    <record id="module_category_foodics_connector" model="ir.module.category">
        <field name="name">Foodics Connector</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_foodics_connector" model="res.groups.privilege">
        <field name="name">Foodics Connector</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="module_category_foodics_connector"/>
    </record>

    <record id="group_foodics_operator" model="res.groups">
        <field name="name">Sync Operator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_foodics_connector"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_foodics_admin" model="res.groups">
        <field name="name">Connector Admin</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_foodics_connector"/>
        <field name="implied_ids" eval="[(4, ref('group_foodics_operator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
