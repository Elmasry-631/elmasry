<odoo>
    <record id="view_foodics_mapping_list" model="ir.ui.view">
        <field name="name">foodics.mapping.list</field>
        <field name="model">foodics.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="connection_id"/>
                <field name="odoo_model"/>
                <field name="foodics_resource"/>
                <field name="odoo_field"/>
                <field name="foodics_field"/>
                <field name="mapping_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_foodics_mapping_form" model="ir.ui.view">
        <field name="name">foodics.mapping.form</field>
        <field name="model">foodics.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="connection_id"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <group>
                            <field name="odoo_model"/>
                            <field name="odoo_field"/>
                        </group>
                        <group>
                            <field name="foodics_resource"/>
                            <field name="foodics_field"/>
                        </group>
                    </group>
                    <group>
                        <field name="mapping_type"/>
                        <field name="default_value"/>
                        <field name="transform_function"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_foodics_mapping" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">foodics.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_foodics_mappings" name="Field Mappings" parent="menu_foodics_configuration" action="action_foodics_mapping" sequence="20"/>
</odoo>

