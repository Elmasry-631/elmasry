<odoo>
    <record id="view_foodics_sync_log_list" model="ir.ui.view">
        <field name="name">foodics.sync.log.list</field>
        <field name="model">foodics.sync.log</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'success'" decoration-danger="status in ('failed', 'dead')" decoration-warning="status == 'retry'">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="sync_type"/>
                <field name="direction"/>
                <field name="foodics_resource"/>
                <field name="foodics_record_id"/>
                <field name="odoo_model"/>
                <field name="odoo_record_id"/>
                <field name="status"/>
                <field name="retry_count"/>
                <field name="next_retry_date"/>
            </list>
        </field>
    </record>

    <record id="view_foodics_sync_log_form" model="ir.ui.view">
        <field name="name">foodics.sync.log.form</field>
        <field name="model">foodics.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary" invisible="status not in ('failed', 'dead')"/>
                    <button name="action_view_odoo_record" type="object" string="Open Odoo Record" invisible="not odoo_model or not odoo_record_id"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="sync_type"/>
                            <field name="direction"/>
                            <field name="foodics_resource"/>
                            <field name="foodics_record_id"/>
                        </group>
                        <group>
                            <field name="odoo_model"/>
                            <field name="odoo_record_id"/>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="next_retry_date"/>
                            <field name="execution_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Error">
                            <field name="error_message"/>
                        </page>
                        <page string="Request">
                            <field name="request_payload"/>
                        </page>
                        <page string="Response">
                            <field name="response_data"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_foodics_sync_log_search" model="ir.ui.view">
        <field name="name">foodics.sync.log.search</field>
        <field name="model">foodics.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="connection_id"/>
                <field name="foodics_record_id"/>
                <field name="odoo_record_id"/>
                <filter name="failed" string="Failed" domain="[('status','in',('failed','dead'))]"/>
                <filter name="success" string="Success" domain="[('status','=','success')]"/>
                <filter name="today" string="Today" domain="[('create_date','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_connection" string="Connection" context="{'group_by':'connection_id'}"/>
                    <filter name="group_sync_type" string="Sync Type" context="{'group_by':'sync_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_foodics_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">foodics.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_foodics_monitoring" name="Monitoring" parent="menu_foodics_root" sequence="20"/>
    <menuitem id="menu_foodics_sync_logs" name="Sync Logs" parent="menu_foodics_monitoring" action="action_foodics_sync_log" sequence="10"/>
</odoo>
