<odoo>
    <record id="view_foodics_webhook_event_list" model="ir.ui.view">
        <field name="name">foodics.webhook.event.list</field>
        <field name="model">foodics.webhook.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="connection_id"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_foodics_webhook_log_list" model="ir.ui.view">
        <field name="name">foodics.webhook.log.list</field>
        <field name="model">foodics.webhook.log</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'done'" decoration-danger="status == 'failed'">
                <field name="received_at"/>
                <field name="connection_id"/>
                <field name="event_type"/>
                <field name="event_id"/>
                <field name="processed"/>
                <field name="status"/>
                <field name="processing_date"/>
            </list>
        </field>
    </record>

    <record id="view_foodics_webhook_log_form" model="ir.ui.view">
        <field name="name">foodics.webhook.log.form</field>
        <field name="model">foodics.webhook.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="event_type"/>
                            <field name="event_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="received_at"/>
                            <field name="processed"/>
                            <field name="processing_date"/>
                            <field name="sync_log_id"/>
                        </group>
                    </group>
                    <group string="Error">
                        <field name="error_message"/>
                    </group>
                    <group string="Payload">
                        <field name="payload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_foodics_webhook_event" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">foodics.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_foodics_webhook_log" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">foodics.webhook.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_foodics_webhook_events" name="Webhook Events" parent="menu_foodics_configuration" action="action_foodics_webhook_event" sequence="30"/>
    <menuitem id="menu_foodics_webhook_logs" name="Webhook Logs" parent="menu_foodics_monitoring" action="action_foodics_webhook_log" sequence="20"/>
</odoo>

