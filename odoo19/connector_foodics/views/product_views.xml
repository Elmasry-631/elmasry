<odoo>
    <record id="view_foodics_product_list" model="ir.ui.view">
        <field name="name">foodics.product.product.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="default_code"/>
                <field name="foodics_id"/>
                <field name="foodics_sync_enabled"/>
                <field name="foodics_last_sync_date"/>
                <button name="action_foodics_sync_now" type="object" string="Sync Now"/>
            </list>
        </field>
    </record>

    <record id="view_foodics_product_form" model="ir.ui.view">
        <field name="name">foodics.product.product.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_foodics_sync_now" type="object" string="Sync Now" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="display_name"/>
                        <field name="default_code"/>
                        <field name="foodics_id"/>
                        <field name="foodics_sync_enabled"/>
                        <field name="foodics_last_sync_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_foodics_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_foodics_product_list"/>
    </record>

    <menuitem id="menu_foodics_data" name="Synchronized Data" parent="menu_foodics_root" sequence="30"/>
    <menuitem id="menu_foodics_products" name="Products" parent="menu_foodics_data" action="action_foodics_products" sequence="10"/>
</odoo>

