<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Prescription Report -->
    <record id="action_report_hospital_prescription" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">hospital.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">el_hospital.report_hospital_prescription_document</field>
        <field name="report_file">el_hospital.report_hospital_prescription_document</field>
        <field name="binding_model_id" ref="model_hospital_prescription"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hospital_prescription_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Medical Prescription</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Prescription #:</strong> <t t-out="doc.name"/><br/>
                                <strong>Date:</strong> <t t-out="doc.prescription_date"/><br/>
                                <strong>State:</strong> <t t-out="doc.state"/>
                            </div>
                            <div class="col-6">
                                <strong>Patient:</strong> <t t-out="doc.patient_id.name"/><br/>
                                <strong>Physician:</strong> <t t-out="doc.physician_id.name"/><br/>
                                <strong>Specialization:</strong> <t t-out="doc.physician_id.specialization"/>
                            </div>
                        </div>
                        <h3 class="mt-4">Medications</h3>
                        <table class="table table-bordered mt-2">
                            <thead>
                                <tr>
                                    <th>Medicament</th>
                                    <th>Dosage</th>
                                    <th>Frequency</th>
                                    <th>Duration</th>
                                    <th>Quantity</th>
                                    <th>Instructions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><t t-out="line.medicament_id.name"/></td>
                                    <td><t t-out="line.dosage"/></td>
                                    <td><t t-out="line.frequency"/></td>
                                    <td><t t-out="line.duration"/></td>
                                    <td><t t-out="line.quantity"/></td>
                                    <td><t t-out="line.instructions"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="doc.notes" class="mt-4">
                            <strong>Notes:</strong>
                            <p><t t-out="doc.notes"/></p>
                        </div>
                        <div class="row mt-5">
                            <div class="col-6 offset-6 text-center">
                                <div style="border-top: 1px solid #000; padding-top: 10px;">
                                    <strong>Physician Signature</strong><br/>
                                    <t t-out="doc.physician_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
