<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_admission_list" model="ir.ui.view">
        <field name="name">hospital.admission.list</field>
        <field name="model">hospital.admission</field>
        <field name="arch" type="xml">
            <list string="Admissions" decoration-info="state == 'admitted'"
                  decoration-success="state == 'discharged'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="department_id"/>
                <field name="ward_id"/>
                <field name="bed_id"/>
                <field name="admission_date"/>
                <field name="discharge_date"/>
                <field name="days_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'admitted'"
                       decoration-success="state == 'discharged'"
                       decoration-danger="state == 'cancelled'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_admission_form" model="ir.ui.view">
        <field name="name">hospital.admission.form</field>
        <field name="model">hospital.admission</field>
        <field name="arch" type="xml">
            <form string="Admission">
                <header>
                    <button name="action_admit" type="object" string="Admit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_discharge" type="object" string="Discharge"
                            class="btn-primary" invisible="state != 'admitted'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-danger" invisible="state in ('discharged', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            class="btn-secondary" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,admitted,discharged"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="physician_id"/>
                            <field name="department_id"/>
                            <field name="ward_id"/>
                            <field name="bed_id"/>
                        </group>
                        <group>
                            <field name="admission_date"/>
                            <field name="discharge_date"/>
                            <field name="days_count"/>
                        </group>
                    </group>
                    <group string="Reason for Admission">
                        <field name="reason" nolabel="1"/>
                    </group>
                    <group string="Discharge Notes" invisible="state != 'discharged'">
                        <field name="discharge_notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_admission_search" model="ir.ui.view">
        <field name="name">hospital.admission.search</field>
        <field name="model">hospital.admission</field>
        <field name="arch" type="xml">
            <search string="Admissions">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="ward_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_admitted" string="Admitted" domain="[('state', '=', 'admitted')]"/>
                <filter name="filter_discharged" string="Discharged" domain="[('state', '=', 'discharged')]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_ward" string="Ward" context="{'group_by': 'ward_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_admission" model="ir.actions.act_window">
        <field name="name">Admissions</field>
        <field name="res_model">hospital.admission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_admission_search"/>
    </record>

    <record id="action_hospital_admission_active" model="ir.actions.act_window">
        <field name="name">Active Admissions</field>
        <field name="res_model">hospital.admission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'admitted')]</field>
    </record>
</odoo>
