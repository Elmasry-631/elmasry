<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_billing_list" model="ir.ui.view">
        <field name="name">hospital.billing.list</field>
        <field name="model">hospital.invoice.billing</field>
        <field name="arch" type="xml">
            <list string="Billings" decoration-success="state == 'paid'"
                  decoration-info="state == 'invoiced'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="billing_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'invoiced'"
                       decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_billing_form" model="ir.ui.view">
        <field name="name">hospital.billing.form</field>
        <field name="model">hospital.invoice.billing</field>
        <field name="arch" type="xml">
            <form string="Billing">
                <header>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_invoice" type="object" string="View Invoice"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_print" type="object" string="Print"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="physician_id"/>
                        </group>
                        <group>
                            <field name="billing_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                    <group string="Lines">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="service_type"/>
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="price_unit"/>
                                <field name="price_subtotal"/>
                                <field name="currency_id" invisible="1"/>
                            </list>
                        </field>
                    </group>
                    <group class="oe_subtotal_footer">
                        <div class="oe_subtotal_footer_separator">
                            <label for="amount_total"/>
                        </div>
                        <field name="amount_total" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hospital_billing" model="ir.actions.act_window">
        <field name="name">Billings</field>
        <field name="res_model">hospital.invoice.billing</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
