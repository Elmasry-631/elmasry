<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_medicament_list" model="ir.ui.view">
        <field name="name">hospital.medicament.list</field>
        <field name="model">hospital.medicament</field>
        <field name="arch" type="xml">
            <list string="Medicaments" decoration-danger="stock_qty &lt;= 0">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="form"/>
                <field name="strength"/>
                <field name="is_prescription_required"/>
                <field name="stock_qty"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_medicament_form" model="ir.ui.view">
        <field name="name">hospital.medicament.form</field>
        <field name="model">hospital.medicament</field>
        <field name="arch" type="xml">
            <form string="Medicament">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="generic_name"/>
                        </group>
                        <group>
                            <field name="form"/>
                            <field name="strength"/>
                            <field name="is_prescription_required"/>
                            <field name="stock_qty"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hospital_medicament" model="ir.actions.act_window">
        <field name="name">Medicaments</field>
        <field name="res_model">hospital.medicament</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
