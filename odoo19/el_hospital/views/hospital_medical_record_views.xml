<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medical Record: List -->
    <record id="view_hospital_medical_record_list" model="ir.ui.view">
        <field name="name">hospital.medical.record.list</field>
        <field name="model">hospital.medical.record</field>
        <field name="arch" type="xml">
            <list string="Medical Records">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="record_date"/>
                <field name="prescription_count"/>
                <field name="lab_test_count"/>
                <field name="radiology_count"/>
            </list>
        </field>
    </record>

    <!-- Medical Record: Form -->
    <record id="view_hospital_medical_record_form" model="ir.ui.view">
        <field name="name">hospital.medical.record.form</field>
        <field name="model">hospital.medical.record</field>
        <field name="arch" type="xml">
            <form string="Medical Record">
                <header>
                    <button name="action_create_prescription" type="object" string="New Prescription" class="btn-primary"/>
                    <button name="action_open_lab_tests" type="object" string="Lab Tests" class="btn-secondary"/>
                    <button name="action_open_radiology" type="object" string="Radiology" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_prescription" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                        </button>
                        <button name="action_open_lab_tests" type="object"
                                class="oe_stat_button" icon="fa-flask">
                            <field name="lab_test_count" widget="statinfo" string="Lab Tests"/>
                        </button>
                        <button name="action_open_radiology" type="object"
                                class="oe_stat_button" icon="fa-x-ray">
                            <field name="radiology_count" widget="statinfo" string="Radiology"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="physician_id"/>
                            <field name="appointment_id"/>
                        </group>
                        <group>
                            <field name="record_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chief Complaint" name="complaint">
                            <field name="chief_complaint" nolabel="1"/>
                        </page>
                        <page string="Diagnosis" name="diagnosis">
                            <field name="diagnosis" nolabel="1"/>
                        </page>
                        <page string="Treatment" name="treatment">
                            <field name="treatment" nolabel="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                        <page string="Prescriptions" name="prescriptions">
                            <field name="prescription_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="prescription_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lab Tests" name="lab_tests">
                            <field name="lab_test_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="test_name"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Radiology" name="radiology">
                            <field name="radiology_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="study_name"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_hospital_medical_record_search" model="ir.ui.view">
        <field name="name">hospital.medical.record.search</field>
        <field name="model">hospital.medical.record</field>
        <field name="arch" type="xml">
            <search string="Medical Records">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <separator/>
                <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                <filter name="group_physician" string="Physician" context="{'group_by': 'physician_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_medical_record" model="ir.actions.act_window">
        <field name="name">Medical Records</field>
        <field name="res_model">hospital.medical.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_medical_record_search"/>
    </record>
</odoo>
