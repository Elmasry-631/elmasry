<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Patient: List -->
    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="ref"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="blood_type"/>
                <field name="physician_id"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!-- Patient: Form -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_open_appointments" type="object" string="Appointments" class="btn-secondary"/>
                    <button name="action_open_admissions" type="object" string="Admissions" class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_appointments" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button name="action_open_admissions" type="object"
                                class="oe_stat_button" icon="fa-bed">
                            <field name="admission_count" widget="statinfo" string="Admissions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="partner_id"/>
                        <h1><field name="partner_id" placeholder="Select or create contact"/></h1>
                        <h3>
                            <field name="ref" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Demographics">
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_type"/>
                        </group>
                        <group string="Medical">
                            <field name="physician_id"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact Info" name="contact">
                            <group>
                                <group>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </group>
                                <group>
                                    <field name="address"/>
                                </group>
                            </group>
                        </page>
                        <page string="Allergies" name="allergies">
                            <field name="allergy_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chronic Diseases" name="diseases">
                            <field name="chronic_disease_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="diagnosed_date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Patient: Search -->
    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patients">
                <field name="name"/>
                <field name="ref"/>
                <field name="physician_id"/>
                <field name="department_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter name="group_gender" string="Gender" context="{'group_by': 'gender'}"/>
                <filter name="group_physician" string="Physician" context="{'group_by': 'physician_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new patient</p>
        </field>
    </record>
</odoo>
