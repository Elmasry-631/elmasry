<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_bed_list" model="ir.ui.view">
        <field name="name">hospital.bed.list</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <list string="Beds" decoration-success="state == 'available'"
                  decoration-danger="state == 'occupied'"
                  decoration-warning="state == 'maintenance'">
                <field name="name"/>
                <field name="ward_id"/>
                <field name="bed_number"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-danger="state == 'occupied'"
                       decoration-warning="state == 'maintenance'"/>
                <field name="patient_id"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_bed_form" model="ir.ui.view">
        <field name="name">hospital.bed.form</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <form string="Bed">
                <header>
                    <button name="action_set_maintenance" type="object" string="Set Maintenance"
                            class="btn-warning" invisible="state != 'available'"/>
                    <button name="action_set_available" type="object" string="Set Available"
                            class="btn-success" invisible="state != 'maintenance'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ward_id"/>
                            <field name="bed_number"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'available'"
                                   decoration-danger="state == 'occupied'"
                                   decoration-warning="state == 'maintenance'"/>
                            <field name="admission_id"/>
                            <field name="patient_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_bed_search" model="ir.ui.view">
        <field name="name">hospital.bed.search</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <search string="Beds">
                <field name="name"/>
                <field name="ward_id"/>
                <filter name="filter_available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="filter_occupied" string="Occupied" domain="[('state', '=', 'occupied')]"/>
                <filter name="filter_maintenance" string="Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <filter name="group_ward" string="Ward" context="{'group_by': 'ward_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_bed" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">hospital.bed</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_bed_search"/>
    </record>
</odoo>
