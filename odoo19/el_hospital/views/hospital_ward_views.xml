<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_ward_list" model="ir.ui.view">
        <field name="name">hospital.ward.list</field>
        <field name="model">hospital.ward</field>
        <field name="arch" type="xml">
            <list string="Wards">
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <field name="ward_type"/>
                <field name="floor"/>
                <field name="bed_count"/>
                <field name="occupied_count"/>
                <field name="available_count"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_ward_form" model="ir.ui.view">
        <field name="name">hospital.ward.form</field>
        <field name="model">hospital.ward</field>
        <field name="arch" type="xml">
            <form string="Ward">
                <header>
                    <button name="action_open_beds" type="object" string="View Beds" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_beds" type="object"
                                class="oe_stat_button" icon="fa-bed">
                            <field name="bed_count" widget="statinfo" string="Beds"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="department_id"/>
                            <field name="ward_type"/>
                            <field name="floor"/>
                        </group>
                        <group>
                            <field name="bed_capacity"/>
                            <field name="bed_count"/>
                            <field name="occupied_count"/>
                            <field name="available_count"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_ward" model="ir.actions.act_window">
        <field name="name">Wards</field>
        <field name="res_model">hospital.ward</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
