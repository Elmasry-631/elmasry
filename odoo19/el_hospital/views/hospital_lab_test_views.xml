<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_lab_test_list" model="ir.ui.view">
        <field name="name">hospital.lab.test.list</field>
        <field name="model">hospital.lab.test</field>
        <field name="arch" type="xml">
            <list string="Lab Tests" decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'completed'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="test_type"/>
                <field name="test_name"/>
                <field name="request_date"/>
                <field name="result_date"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'requested'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_lab_test_form" model="ir.ui.view">
        <field name="name">hospital.lab.test.form</field>
        <field name="model">hospital.lab.test</field>
        <field name="arch" type="xml">
            <form string="Lab Test">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_complete" type="object" string="Complete"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-danger" invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="physician_id"/>
                            <field name="medical_record_id"/>
                        </group>
                        <group>
                            <field name="test_type"/>
                            <field name="test_name"/>
                            <field name="request_date"/>
                            <field name="result_date"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="result" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_lab_test_search" model="ir.ui.view">
        <field name="name">hospital.lab.test.search</field>
        <field name="model">hospital.lab.test</field>
        <field name="arch" type="xml">
            <search string="Lab Tests">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="test_name"/>
                <filter name="filter_requested" string="Requested" domain="[('state', '=', 'requested')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'test_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_lab_test" model="ir.actions.act_window">
        <field name="name">Lab Tests</field>
        <field name="res_model">hospital.lab.test</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_lab_test_search"/>
    </record>
</odoo>
