<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Prescription: List -->
    <record id="view_hospital_prescription_list" model="ir.ui.view">
        <field name="name">hospital.prescription.list</field>
        <field name="model">hospital.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="prescription_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Prescription: Form -->
    <record id="view_hospital_prescription_form" model="ir.ui.view">
        <field name="name">hospital.prescription.form</field>
        <field name="model">hospital.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_done" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_print" type="object" string="Print"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="physician_id"/>
                            <field name="medical_record_id"/>
                        </group>
                        <group>
                            <field name="prescription_date"/>
                        </group>
                    </group>
                    <group string="Medications">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="medicament_id"/>
                                <field name="dosage"/>
                                <field name="frequency"/>
                                <field name="duration"/>
                                <field name="quantity"/>
                                <field name="instructions"/>
                            </list>
                        </field>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">hospital.prescription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
