<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for approval request names -->
    <record id="seq_credit_approval_request" model="ir.sequence">
        <field name="name">Credit Approval Request Sequence</field>
        <field name="code">credit.approval.request</field>
        <field name="prefix">CR/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Email Template: Notify Supervisor -->
    <record id="email_template_credit_approval" model="mail.template">
        <field name="name">Credit Approval — Notify Supervisor</field>
        <field name="model_id" ref="model_credit_approval_request"/>
        <field name="subject">Credit Approval Required — %(name)s</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;font-size:14px;">
    <p>Dear <t t-esc="object.supervisor_id.name"/>,</p>
    <p>
        A credit approval request has been submitted by
        <strong><t t-esc="object.requested_by.name"/></strong>
        and requires your review.
    </p>
    <table style="border-collapse:collapse;margin:16px 0;">
        <tr>
            <td style="padding:6px 12px;border:1px solid #ddd;font-weight:bold;">Sale Order</td>
            <td style="padding:6px 12px;border:1px solid #ddd;"><t t-esc="object.sale_order_id.name"/></td>
        </tr>
        <tr>
            <td style="padding:6px 12px;border:1px solid #ddd;font-weight:bold;">Customer</td>
            <td style="padding:6px 12px;border:1px solid #ddd;"><t t-esc="object.partner_id.name"/></td>
        </tr>
        <tr>
            <td style="padding:6px 12px;border:1px solid #ddd;font-weight:bold;">Credit Limit</td>
            <td style="padding:6px 12px;border:1px solid #ddd;"><t t-esc="'{:,.2f}'.format(object.credit_limit)"/></td>
        </tr>
        <tr>
            <td style="padding:6px 12px;border:1px solid #ddd;font-weight:bold;">Credit Used</td>
            <td style="padding:6px 12px;border:1px solid #ddd;"><t t-esc="'{:,.2f}'.format(object.credit_used)"/></td>
        </tr>
        <tr>
            <td style="padding:6px 12px;border:1px solid #ddd;font-weight:bold;">Order Amount</td>
            <td style="padding:6px 12px;border:1px solid #ddd;"><t t-esc="'{:,.2f}'.format(object.order_amount)"/></td>
        </tr>
        <tr>
            <td style="padding:6px 12px;border:1px solid #ddd;font-weight:bold;color:red;">Exceeded By</td>
            <td style="padding:6px 12px;border:1px solid #ddd;color:red;"><t t-esc="'{:,.2f}'.format(object.exceeded_by)"/></td>
        </tr>
    </table>
    <p>
        Please review and take action in Odoo.
    </p>
</div>
        </field>
        <field name="email_to">${object.supervisor_id.email_formatted | safe}</field>
        <field name="email_from">${(object.create_uid.email_formatted or user.email_formatted) | safe}</field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- ============ List View ============ -->
    <record id="view_credit_approval_request_list" model="ir.ui.view">
        <field name="name">credit.approval.request.list</field>
        <field name="model">credit.approval.request</field>
        <field name="arch" type="xml">
            <list string="Credit Approval Requests"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="requested_by"/>
                <field name="supervisor_id"/>
                <field name="credit_limit" widget="monetary" optional="show"/>
                <field name="order_amount" widget="monetary" optional="show"/>
                <field name="exceeded_by" widget="monetary" decoration-danger="exceeded_by &gt; 0" optional="show"/>
                <field name="rejection_reason_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'submitted'"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============ Form View ============ -->
    <record id="view_credit_approval_request_form" model="ir.ui.view">
        <field name="name">credit.approval.request.form</field>
        <field name="model">credit.approval.request</field>
        <field name="arch" type="xml">
            <form string="Credit Approval Request">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="el_nmo_credit_approval.group_credit_approval_supervisor"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="el_nmo_credit_approval.group_credit_approval_supervisor"/>
                    <button name="action_resubmit" type="object"
                            string="Resubmit"
                            invisible="state != 'rejected'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state not in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Request Info">
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="requested_by"/>
                            <field name="supervisor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Credit Details">
                            <field name="credit_limit"/>
                            <field name="credit_used"/>
                            <field name="order_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="exceeded_by" decoration-danger="exceeded_by &gt; 0"/>
                        </group>
                    </group>

                    <group invisible="state != 'rejected'" string="Rejection Details">
                        <group>
                            <field name="rejection_reason_id"
                                   invisible="state != 'submitted' and state != 'rejected'"
                                   />
                        </group>
                        <group>
                            <field name="rejection_notes"
                                   placeholder="Optional additional notes..."/>
                        </group>
                    </group>

                    <group invisible="state not in ('approved', 'rejected')">
                        <field name="approval_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ Search View ============ -->
    <record id="view_credit_approval_request_search" model="ir.ui.view">
        <field name="name">credit.approval.request.search</field>
        <field name="model">credit.approval.request</field>
        <field name="arch" type="xml">
            <search string="Search Credit Approvals">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="requested_by"/>
                <field name="supervisor_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_my_requests" string="My Requests"
                        domain="[('requested_by', '=', uid)]"/>
                <filter name="filter_to_approve" string="To Approve"
                        domain="[('supervisor_id', '=', uid), ('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_supervisor" string="Supervisor" context="{'group_by': 'supervisor_id'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============ Action ============ -->
    <record id="action_credit_approval_request" model="ir.actions.act_window">
        <field name="name">Credit Approvals</field>
        <field name="res_model">credit.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_credit_approval_request_search"/>
        <field name="context">{'search_default_filter_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credit approval requests
            </p>
            <p>
                Credit approval requests are created automatically when a
                salesperson tries to confirm an order that exceeds the
                customer's credit limit.
            </p>
        </field>
    </record>

</odoo>