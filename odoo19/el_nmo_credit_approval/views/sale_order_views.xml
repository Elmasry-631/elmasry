<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add approval status + buttons to Sale Order form -->
    <record id="view_sale_order_form_credit_approval" model="ir.ui.view">
        <field name="name">sale.order.credit.approval.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Credit Blocked Alert Banner -->
            <xpath expr="//div[@name='button_box']" position="before">
                <field name="is_credit_blocked" invisible="1"/>
                <field name="credit_approval_state" invisible="1"/>
                <field name="credit_approval_id" invisible="1"/>

                <!-- Blocked: pending approval -->
                <div class="alert alert-warning mb-0"
                     role="alert"
                     style="margin-bottom:0!important;"
                     invisible="not is_credit_blocked or credit_approval_state == 'approved'">
                    <strong>Credit Limit Exceeded — Approval Pending</strong><br/>
                    An approval request has been sent to your supervisor.
                    <field name="credit_approval_id"
                           invisible="credit_approval_state == 'none'"
                           string="View Request"
                           class="oe_inline"/>
                </div>

                <!-- Approved -->
                <div class="alert alert-success mb-0"
                     role="alert"
                     style="margin-bottom:0!important;"
                     invisible="credit_approval_state != 'approved'">
                    <strong>Credit Approved</strong> —
                    This order has been approved for exceeding the credit limit.
                    <field name="credit_approval_id" string="View Approval"/>
                </div>

                <!-- Rejected -->
                <div class="alert alert-danger mb-0"
                     role="alert"
                     style="margin-bottom:0!important;"
                     invisible="credit_approval_state != 'rejected'">
                    <strong>Credit Approval Rejected</strong> —
                    This order was rejected. Contact your supervisor.
                    <field name="credit_approval_id" string="View Request"/>
                </div>
            </xpath>

            <!-- Show approval state in header status bar area -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="credit_approval_state"
                       widget="badge"
                       decoration-info="credit_approval_state == 'pending'"
                       decoration-success="credit_approval_state == 'approved'"
                       decoration-danger="credit_approval_state == 'rejected'"
                       invisible="credit_approval_state == 'none'"/>
            </xpath>

            <!-- Review & Approve button in the button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(credit_approval_wizard_action)d"
                        type="action"
                        string="Credit Approval"
                        class="btn-info"
                        groups="el_nmo_credit_approval.group_credit_approval_supervisor,el_nmo_credit_approval.group_credit_approval_manager"
                        invisible="credit_approval_state == 'none' or credit_approval_state == 'approved' or credit_approval_state == 'rejected'"/>
            </xpath>

        </field>
    </record>

    <!-- Add credit_approval_state to SO list view -->
    <record id="view_sale_order_list_credit_approval" model="ir.ui.view">
        <field name="name">sale.order.credit.approval.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="credit_approval_state"
                       widget="badge"
                       decoration-info="credit_approval_state == 'pending'"
                       decoration-success="credit_approval_state == 'approved'"
                       decoration-danger="credit_approval_state == 'rejected'"
                       invisible="credit_approval_state == 'none'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Add filter to SO search -->
    <record id="view_sale_order_search_credit_approval" model="ir.ui.view">
        <field name="name">sale.order.credit.approval.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="filter_credit_pending" string="Credit Pending"
                        domain="[('credit_approval_state', '=', 'pending')]"/>
                <filter name="filter_credit_approved" string="Credit Approved"
                        domain="[('credit_approval_state', '=', 'approved')]"/>
                <filter name="filter_credit_rejected" string="Credit Rejected"
                        domain="[('credit_approval_state', '=', 'rejected')]"/>
            </xpath>
        </field>
    </record>

</odoo>
