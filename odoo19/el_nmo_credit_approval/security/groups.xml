<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_credit_approval" model="res.groups.privilege">
        <field name="name">Credit Approval</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
    </record>

    <!-- Salesperson: can create requests, view -->
    <record id="group_credit_approval_salesperson" model="res.groups">
        <field name="name">Credit Approval — Salesperson</field>
        <field name="privilege_id" ref="privilege_credit_approval"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- Supervisor: can approve/reject -->
    <record id="group_credit_approval_supervisor" model="res.groups">
        <field name="name">Credit Approval — Supervisor</field>
        <field name="privilege_id" ref="privilege_credit_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_credit_approval_salesperson'))]"/>
    </record>

    <!-- Manager: full access + manage rejection reasons -->
    <record id="group_credit_approval_manager" model="res.groups">
        <field name="name">Credit Approval — Manager</field>
        <field name="privilege_id" ref="privilege_credit_approval"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

</odoo>
