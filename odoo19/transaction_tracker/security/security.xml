<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Security Groups                                               -->
        <!-- ============================================================ -->

        <!-- Transaction Tracker Manager: Full access to all logs + config -->
        <record id="group_transaction_tracker_manager" model="res.groups">
            <field name="name">Transaction Tracker / Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Transaction Tracker User: Read-only access to logs -->
        <record id="group_transaction_tracker_user" model="res.groups">
            <field name="name">Transaction Tracker / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ============================================================ -->
        <!-- Record Rules                                                  -->
        <!-- ============================================================ -->

        <!-- Managers can see all transaction logs -->
        <record id="transaction_log_manager_rule" model="ir.rule">
            <field name="name">Transaction Log: Manager sees all</field>
            <field name="model_id" ref="model_transaction_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_transaction_tracker_manager'))]"/>
        </record>

        <!-- Users can only see their own transaction logs -->
        <record id="transaction_log_user_rule" model="ir.rule">
            <field name="name">Transaction Log: User sees own</field>
            <field name="model_id" ref="model_transaction_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_transaction_tracker_user'))]"/>
        </record>

        <!-- Tracker Config: Only managers can access -->
        <record id="tracker_config_manager_rule" model="ir.rule">
            <field name="name">Tracker Config: Manager access</field>
            <field name="model_id" ref="model_transaction_tracker_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_transaction_tracker_manager'))]"/>
        </record>

    </data>
</odoo>
