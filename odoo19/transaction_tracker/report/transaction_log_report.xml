<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Report Action                                                 -->
    <!-- ============================================================ -->
    <record id="action_report_transaction_log" model="ir.actions.report">
        <field name="name">Transaction Log Report</field>
        <field name="model">transaction.log</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transaction_tracker.report_transaction_log</field>
        <field name="report_file">transaction_tracker.report_transaction_log</field>
        <field name="print_report_name">'Transaction Log - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_transaction_log"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Menu action for the report -->
    <record id="action_report_transaction_log_menu" model="ir.actions.act_window">
        <field name="name">Transaction Report</field>
        <field name="res_model">transaction.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_month': 1}</field>
    </record>

</odoo>
