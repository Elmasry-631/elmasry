<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Sequence for Transaction Log References                       -->
        <!-- ============================================================ -->
        <record id="seq_transaction_log" model="ir.sequence">
            <field name="name">Transaction Log Sequence</field>
            <field name="code">transaction.log</field>
            <field name="prefix">TXN/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ============================================================ -->
        <!-- Auto-populate: Create tracker configs for common models       -->
        <!-- on module install (via post_init_hook)                        -->
        <!-- ============================================================ -->
        <!-- The actual auto-population is handled by the post_init_hook  -->
        <!-- defined in __init__.py to ensure all models are registered.  -->

    </data>
</odoo>
