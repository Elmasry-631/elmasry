<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Dashboard Action (Pivot + Graph combined view)                -->
    <!-- ============================================================ -->
    <record id="action_transaction_dashboard" model="ir.actions.act_window">
        <field name="name">Transaction Dashboard</field>
        <field name="res_model">transaction.log</field>
        <field name="view_mode">pivot,graph,kanban</field>
        <field name="search_view_id" ref="view_transaction_log_search"/>
        <field name="context">{'search_default_filter_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transaction data for the dashboard
            </p>
            <p>
                The dashboard shows activity trends, user statistics, and model usage patterns.
            </p>
        </field>
    </record>

</odoo>
