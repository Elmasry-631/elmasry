<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_cheque_endorsement" model="ir.ui.view">
        <field name="name">account.move.form.cheque.endorsement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cheque" type="object" class="oe_stat_button" icon="fa-money" invisible="not cheque_id and not cheque_endorsement_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Cheque</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
