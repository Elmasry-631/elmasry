<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cheque_endorse_wizard_form" model="ir.ui.view">
        <field name="name">cheque.endorse.wizard.form</field>
        <field name="model">cheque.endorse.wizard</field>
        <field name="arch" type="xml">
            <form string="Endorse Cheque">
                <group>
                    <field name="cheque_id"/>
                    <field name="current_beneficiary_id"/>
                    <field name="endorsee_partner_id"/>
                    <field name="endorsement_date"/>
                    <field name="create_vendor_bill"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
