<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inter_company_transfer" model="ir.ui.view">
        <field name="name">res.company.form.inter.company.transfer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="InterCompany">
                    <group>
                        <field name="inter_company_warehouse_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
