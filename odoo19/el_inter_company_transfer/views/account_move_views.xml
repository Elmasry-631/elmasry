<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inter_company_transfer" model="ir.ui.view">
        <field name="name">account.move.form.inter.company.transfer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_inter_company_transfer" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not inter_company_transfer_id">
                    <field name="inter_company_transfer_id" string="ICT" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
