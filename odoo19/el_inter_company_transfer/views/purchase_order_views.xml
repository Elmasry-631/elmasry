<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inter_company_transfer" model="ir.ui.view">
        <field name="name">purchase.order.form.inter.company.transfer</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_inter_company_transfer" type="object" class="oe_stat_button" icon="fa-exchange" invisible="not inter_company_transfer_id">
                    <field name="inter_company_transfer_id" string="ICT" widget="statinfo"/>
                </button>
                <button name="action_view_inter_company_sale_order" type="object" class="oe_stat_button" icon="fa-dollar" invisible="not inter_company_sale_order_id">
                    <field name="inter_company_sale_order_id" string="IC Sale" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
