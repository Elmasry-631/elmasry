<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rules for Multi-Company -->
        <record id="rule_account_feature_multi_company" model="ir.rule">
            <field name="name">Account Feature Multi-Company</field>
            <field name="model_id" ref="model_account_feature"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_account_cost_center_multi_company" model="ir.rule">
            <field name="name">Account Cost Center Multi-Company</field>
            <field name="model_id" ref="model_account_cost_center"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_account_patch_number_multi_company" model="ir.rule">
            <field name="name">Account Patch Number Multi-Company</field>
            <field name="model_id" ref="model_account_patch_number"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
