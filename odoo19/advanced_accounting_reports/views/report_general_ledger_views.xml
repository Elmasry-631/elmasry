<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_general_ledger_report_list" model="ir.ui.view">
        <field name="name">account.move.line.list.gl.report</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="General Ledger" create="false" edit="false" delete="false" default_order="date asc">
                <field name="date"/>
                <field name="move_id" optional="show"/>
                <field name="journal_id" optional="show"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="account_id"/>
                <field name="feature_ids" optional="show" widget="many2many_tags"/>
                <field name="cost_center_ids" optional="show" widget="many2many_tags"/>
                <field name="patch_number_id" optional="show" string="Patch Number"/>
                <field name="debit" sum="Total Debit"/>
                <field name="credit" sum="Total Credit"/>
                <field name="balance" sum="Total Balance"/>
                <field name="secondary_debit" optional="show" sum="Total Secondary Debit" widget="monetary"/>
                <field name="secondary_credit" optional="show" sum="Total Secondary Credit" widget="monetary"/>
                <field name="secondary_balance" optional="show" sum="Total Secondary Balance" widget="monetary"/>
                <field name="manual_rate" optional="hide" sum=""/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
