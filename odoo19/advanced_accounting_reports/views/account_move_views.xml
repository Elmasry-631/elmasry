<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Account Move Form -->
    <record id="view_move_form_inherit_advanced" model="ir.ui.view">
        <field name="name">account.move.form.inherit.advanced</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add Patch Number after Reference -->
            <field name="ref" position="after">
                <field name="patch_number_id" options="{'no_create': True}"/>
            </field>
            <!-- Secondary Currency is auto-populated - invisible to user -->
            <field name="date" position="after">
                <field name="secondary_currency_id" invisible="1"/>
                <field name="use_manual_rate"/>
                <field name="manual_rate" invisible="not use_manual_rate" required="use_manual_rate"/>
            </field>
        </field>
    </record>

    <!-- Inherit Account Move Tree (List) to add secondary total column next to primary total -->
    <record id="view_move_tree_inherit_advanced" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.advanced</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="secondary_debit_total" optional="show" widget="monetary" sum="Total"/>
            </field>
        </field>
    </record>

</odoo>
