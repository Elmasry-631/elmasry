<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_classification" model="ir.ui.view">
        <field name="name">sale.order.classification.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="before">
                <field name="payment_gateway_id" invisible="1"/>
                <div class="alert alert-info mb-0"
                     role="alert"
                     style="margin-bottom:0!important;"
                     invisible="partner_payment_type != 'credit'">
                    <field name="partner_classification_id" invisible="1"/>
                    <strong>Credit Info: </strong>
                    Limit: <field name="partner_effective_credit_limit" class="me-2"/>
                    Outstanding: <field name="partner_outstanding" class="me-2"/>
                    Remaining:
                    <field name="partner_remaining_credit"
                           class="me-2"
                           decoration-danger="partner_remaining_credit &lt;= 0"/>
                    Policy:
                    <field name="partner_credit_policy" class="me-2"/>
                </div>
            </xpath>

        </field>
    </record>

    <record id="view_sale_order_search_classification" model="ir.ui.view">
        <field name="name">sale.order.classification.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="filter_has_classification" string="Has Classification"
                        domain="[('partner_classification_id', '!=', False)]"/>
                <filter name="group_classification" string="Classification"
                        context="{'group_by': 'partner_classification_id'}"/>
            </xpath>

        </field>
    </record>

</odoo>
