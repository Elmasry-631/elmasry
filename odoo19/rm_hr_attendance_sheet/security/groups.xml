<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_attendance_sheet">
        <field name="name">Attendance Sheets</field>
        <field name="sequence">17</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_attendance_sheet_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_sheet"/>
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <record id="group_attendance_sheet_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_sheet"/>
        <field name="implied_ids" eval="[(4, ref('group_attendance_sheet_user')), (4, ref('hr_payroll.group_hr_payroll_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_attendance_sheet_company" model="ir.rule">
            <field name="name">Attendance Sheet: company</field>
            <field name="model_id" ref="model_rm_attendance_sheet"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_attendance_sheet_line_company" model="ir.rule">
            <field name="name">Attendance Sheet Line: company</field>
            <field name="model_id" ref="model_rm_attendance_sheet_line"/>
            <field name="domain_force">['|', ('sheet_id.company_id', '=', False), ('sheet_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
