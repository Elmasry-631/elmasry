<odoo>
    <record id="view_rm_attendance_policy_list" model="ir.ui.view">
        <field name="name">rm.attendance.policy.list</field>
        <field name="model">rm.attendance.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="effective_date"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rm_attendance_policy_form" model="ir.ui.view">
        <field name="name">rm.attendance.policy.form</field>
        <field name="model">rm.attendance.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="effective_date"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Overtime Rules">
                            <field name="overtime_rule_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="ot_type"/>
                                    <field name="apply_after"/>
                                    <field name="rate"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lateness Rules">
                            <field name="lateness_rule_ids"/>
                        </page>
                        <page string="Absence Rules">
                            <field name="absence_rule_ids"/>
                        </page>
                        <page string="Employee Records">
                            <field name="version_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rm_attendance_policy" model="ir.actions.act_window">
        <field name="name">Attendance Policies</field>
        <field name="res_model">rm.attendance.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
