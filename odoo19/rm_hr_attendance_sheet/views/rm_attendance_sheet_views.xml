<odoo>
    <record id="view_rm_attendance_sheet_line_list" model="ir.ui.view">
        <field name="name">rm.attendance.sheet.line.list</field>
        <field name="model">rm.attendance.sheet.line</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_absent" decoration-info="day_type == 'holiday'" decoration-muted="day_type == 'weekend'" decoration-success="is_leave">
                <field name="date"/>
                <field name="day_name"/>
                <field name="day_type"/>
                <field name="planned_hours"/>
                <field name="worked_hours"/>
                <field name="overtime_hours"/>
                <field name="overtime_type"/>
                <field name="late_in_minutes"/>
                <field name="is_absent"/>
                <field name="is_leave"/>
                <field name="difference_hours"/>
                <field name="overtime_amount"/>
                <field name="late_penalty"/>
                <field name="absence_penalty"/>
            </list>
        </field>
    </record>

    <record id="view_rm_attendance_sheet_list" model="ir.ui.view">
        <field name="name">rm.attendance.sheet.list</field>
        <field name="model">rm.attendance.sheet</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="policy_id"/>
                <field name="total_worked_hours"/>
                <field name="total_overtime"/>
                <field name="total_late_in"/>
                <field name="total_absence_days"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_rm_attendance_sheet_form" model="ir.ui.view">
        <field name="name">rm.attendance.sheet.form</field>
        <field name="model">rm.attendance.sheet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calculate" type="object" string="Calculate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_change_wizard" type="object" string="Modify Line" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_payslip" type="object" string="Create Payslip" class="btn-primary" invisible="state != 'confirmed' or payslip_id"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_create_payslip" icon="fa-file-text-o" invisible="state != 'confirmed' or payslip_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Create Payslip</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="version_id" readonly="state != 'draft'"/>
                            <field name="policy_id"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id"/>
                            <field name="payslip_id"/>
                        </group>
                    </group>
                    <group string="Summary" col="4">
                        <field name="total_planned_hours"/>
                        <field name="total_worked_hours"/>
                        <field name="total_overtime"/>
                        <field name="total_late_in"/>
                        <field name="total_absence_days"/>
                        <field name="total_leave_days"/>
                        <field name="total_difference"/>
                        <field name="total_overtime_amount"/>
                        <field name="total_late_penalty"/>
                        <field name="total_absence_penalty"/>
                        <field name="total_difference_amount"/>
                    </group>
                    <notebook>
                        <page string="Daily Lines">
                            <field name="sheet_line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-danger="is_absent" decoration-info="day_type == 'holiday'" decoration-muted="day_type == 'weekend'" decoration-success="is_leave">
                                    <field name="date"/>
                                    <field name="day_name"/>
                                    <field name="day_type"/>
                                    <field name="planned_hours"/>
                                    <field name="worked_hours"/>
                                    <field name="overtime_hours"/>
                                    <field name="overtime_type"/>
                                    <field name="late_in_minutes"/>
                                    <field name="is_absent"/>
                                    <field name="is_leave"/>
                                    <field name="leave_id"/>
                                    <field name="public_holiday_id"/>
                                    <field name="difference_hours"/>
                                    <field name="overtime_amount"/>
                                    <field name="late_penalty"/>
                                    <field name="absence_penalty"/>
                                    <field name="change_note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rm_attendance_sheet_search" model="ir.ui.view">
        <field name="name">rm.attendance.sheet.search</field>
        <field name="model">rm.attendance.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="policy_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by':'department_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rm_attendance_sheet" model="ir.actions.act_window">
        <field name="name">Attendance Sheets</field>
        <field name="res_model">rm.attendance.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rm_attendance_sheet_search"/>
    </record>
</odoo>
