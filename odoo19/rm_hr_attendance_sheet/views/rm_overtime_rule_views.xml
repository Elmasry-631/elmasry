<odoo>
    <record id="view_rm_overtime_rule_list" model="ir.ui.view">
        <field name="name">rm.overtime.rule.list</field>
        <field name="model">rm.overtime.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="policy_id"/>
                <field name="ot_type"/>
                <field name="apply_after"/>
                <field name="rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rm_overtime_rule_form" model="ir.ui.view">
        <field name="name">rm.overtime.rule.form</field>
        <field name="model">rm.overtime.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="policy_id"/>
                        <field name="ot_type"/>
                        <field name="apply_after"/>
                        <field name="rate"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rm_overtime_rule" model="ir.actions.act_window">
        <field name="name">Overtime Rules</field>
        <field name="res_model">rm.overtime.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
