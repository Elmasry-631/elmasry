<odoo>
    <record id="view_hr_payslip_form_attendance_sheet" model="ir.ui.view">
        <field name="name">hr.payslip.form.attendance.sheet</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='version_id']" position="after">
                <field name="attendance_sheet_id"/>
            </xpath>
        </field>
    </record>
</odoo>
