<odoo>
    <record id="view_hr_version_form_attendance_policy" model="ir.ui.view">
        <field name="name">hr.version.form.attendance.policy</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="attendance_policy_id"/>
            </xpath>
        </field>
    </record>
</odoo>
