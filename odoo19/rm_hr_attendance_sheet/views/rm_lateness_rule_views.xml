<odoo>
    <record id="view_rm_lateness_rule_list" model="ir.ui.view">
        <field name="name">rm.lateness.rule.list</field>
        <field name="model">rm.lateness.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="policy_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rm_lateness_rule_form" model="ir.ui.view">
        <field name="name">rm.lateness.rule.form</field>
        <field name="model">rm.lateness.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="policy_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Steps">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="min_minutes"/>
                                    <field name="max_minutes"/>
                                    <field name="step_type"/>
                                    <field name="rate_value"/>
                                    <field name="fixed_amount"/>
                                    <field name="penalty_calc"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rm_lateness_rule" model="ir.actions.act_window">
        <field name="name">Lateness Rules</field>
        <field name="res_model">rm.lateness.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
