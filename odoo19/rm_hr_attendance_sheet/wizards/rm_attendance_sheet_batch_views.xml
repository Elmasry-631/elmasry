<odoo>
    <record id="view_rm_attendance_sheet_batch_wizard_form" model="ir.ui.view">
        <field name="name">rm.attendance.sheet.batch.wizard.form</field>
        <field name="model">rm.attendance.sheet.batch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="department_id"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="employee_category_ids" widget="many2many_tags"/>
                    <field name="calculate_now"/>
                    <field name="summary" readonly="1"/>
                </group>
                <footer>
                    <button name="action_create_sheets" type="object" string="Create Sheets" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rm_attendance_sheet_batch" model="ir.actions.act_window">
        <field name="name">Batch Attendance Sheets</field>
        <field name="res_model">rm.attendance.sheet.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
