<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Form View ─── -->
    <record id="view_el_stock_alert_form" model="ir.ui.view">
        <field name="name">el.stock.alert.form</field>
        <field name="model">el.stock.alert</field>
        <field name="arch" type="xml">
            <form string="Negative Stock Alert" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Product &amp; Location">
                            <field name="product_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                        </group>
                        <group string="Quantities">
                            <field name="requested_qty" readonly="1"/>
                            <field name="available_qty" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Info">
                            <field name="user_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── List View ─── -->
    <record id="view_el_stock_alert_list" model="ir.ui.view">
        <field name="name">el.stock.alert.list</field>
        <field name="model">el.stock.alert</field>
        <field name="arch" type="xml">
            <list string="Negative Stock Alerts"
                  decoration-danger="available_qty == 0">
                <field name="name"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="requested_qty"/>
                <field name="available_qty"/>
                <field name="user_id"/>
                <field name="create_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ─── Search View ─── -->
    <record id="view_el_stock_alert_search" model="ir.ui.view">
        <field name="name">el.stock.alert.search</field>
        <field name="model">el.stock.alert</field>
        <field name="arch" type="xml">
            <search string="Search Alerts">
                <field name="name"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <filter name="filter_today" string="Today"
                        domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="group_product" string="Product"
                        context="{'group_by': 'product_id'}"/>
                <filter name="group_location" string="Location"
                        context="{'group_by': 'location_id'}"/>
                <filter name="group_user" string="User"
                        context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <!-- ─── Action ─── -->
    <record id="action_el_stock_alert" model="ir.actions.act_window">
        <field name="name">Negative Stock Alerts</field>
        <field name="res_model">el.stock.alert</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No negative stock alerts yet
            </p>
            <p>
                Alerts appear here when a stock move is rejected because
                it would have resulted in negative stock.
            </p>
        </field>
    </record>

</odoo>
