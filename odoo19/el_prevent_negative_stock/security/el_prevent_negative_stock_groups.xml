<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_el_prevent_negative_stock" model="ir.module.category">
        <field name="name">Prevent Negative Stock</field>
    </record>

    <record id="group_alert_user" model="res.groups">
        <field name="name">Alert User (View Own)</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_alert_manager" model="res.groups">
        <field name="name">Alert Manager (View All + Delete)</field>
        <field name="implied_ids" eval="[(4, ref('group_alert_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
