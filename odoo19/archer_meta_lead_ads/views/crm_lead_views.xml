<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_meta_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.meta.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Meta" invisible="not x_meta_leadgen_id">
                    <group>
                        <field name="x_meta_leadgen_id" readonly="1"/>
                        <field name="x_meta_platform" readonly="1"/>
                        <field name="x_meta_page_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="x_meta_form_id" readonly="1"/>
                        <field name="x_meta_campaign_name" readonly="1"/>
                        <field name="x_meta_ad_name" readonly="1"/>
                        <field name="x_meta_created_time" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_search_meta_inherit" model="ir.ui.view">
        <field name="name">crm.lead.search.meta.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_search_forecast"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_meta_leads" string="Meta Leads" domain="[('x_meta_leadgen_id', '!=', False)]"/>
                <field name="x_meta_page_id"/>
                <field name="x_meta_form_id"/>
                <group expand="0" string="Meta Group By">
                    <filter name="group_meta_page" string="Meta Page" context="{'group_by': 'x_meta_page_id'}"/>
                    <filter name="group_meta_form" string="Meta Form" context="{'group_by': 'x_meta_form_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
