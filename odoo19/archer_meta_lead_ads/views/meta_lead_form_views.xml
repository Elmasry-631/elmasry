<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_lead_form_list" model="ir.ui.view">
        <field name="name">meta.lead.form.list</field>
        <field name="model">meta.lead.form</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="page_id"/>
                <field name="status"/>
                <field name="crm_team_id"/>
                <field name="fetch_frequency_minutes"/>
                <field name="mapping_count"/>
                <field name="lead_count"/>
                <field name="last_fetch_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_meta_lead_form_form" model="ir.ui.view">
        <field name="name">meta.lead.form.form</field>
        <field name="model">meta.lead.form</field>
        <field name="arch" type="xml">
            <form string="Meta Lead Form">
                <header>
                    <button name="action_fetch_form_fields" type="object" string="Fetch Form Fields" class="btn-secondary"/>
                    <button name="action_fetch_leads" type="object" string="Fetch Leads" class="btn-primary"/>
                    <button name="action_view_leads" type="object" string="View Leads" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="page_id"/>
                            <field name="form_id"/>
                            <field name="status"/>
                            <field name="locale"/>
                        </group>
                        <group>
                            <field name="crm_team_id"/>
                            <field name="utm_source_id"/>
                            <field name="utm_medium_id"/>
                            <field name="fetch_frequency_minutes"/>
                            <field name="created_time"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Field Mapping">
                            <field name="mapping_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="meta_field_key"/>
                                    <field name="odoo_field_id"/>
                                    <field name="lookup_field" invisible="odoo_field_ttype not in ('many2one', 'many2many')"/>
                                    <field name="transform"/>
                                    <field name="is_default"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Form Schema">
                            <field name="questions_json" nolabel="1" widget="text"/>
                        </page>
                        <page string="Statistics">
                            <group>
                                <field name="last_fetch_date"/>
                                <field name="fetch_frequency_minutes"/>
                                <field name="lead_count"/>
                                <field name="mapping_count"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_meta_lead_form_search" model="ir.ui.view">
        <field name="name">meta.lead.form.search</field>
        <field name="model">meta.lead.form</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="page_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('status', '=', 'ARCHIVED')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_page" string="Page" context="{'group_by': 'page_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'crm_team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meta_lead_form" model="ir.actions.act_window">
        <field name="name">Forms</field>
        <field name="res_model">meta.lead.form</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_lead_form_search"/>
    </record>
</odoo>
