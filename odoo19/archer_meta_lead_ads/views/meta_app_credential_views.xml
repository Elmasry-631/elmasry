<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_app_credential_list" model="ir.ui.view">
        <field name="name">meta.app.credential.list</field>
        <field name="model">meta.app.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
                <field name="token_expiry_date"/>
                <field name="last_sync_date"/>
                <field name="page_count"/>
                <field name="sync_issue_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_meta_app_credential_search" model="ir.ui.view">
        <field name="name">meta.app.credential.search</field>
        <field name="model">meta.app.credential</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter name="filter_connected" string="Connected" domain="[('state', '=', 'connected')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_meta_app_credential_form" model="ir.ui.view">
        <field name="name">meta.app.credential.form</field>
        <field name="model">meta.app.credential</field>
        <field name="arch" type="xml">
            <form string="Meta Credential">
                <header>
                    <button name="action_generate_token" type="object" string="Generate Token" class="btn-primary"/>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_fetch_pages" type="object" string="Fetch Pages" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,expired,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pages" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="page_count" widget="statinfo" string="Pages"/>
                        </button>
                        <button name="action_view_sync_issues" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="sync_issue_count" widget="statinfo" string="Sync Issues"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Cairo Real Estate FB Account"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="app_id" placeholder="e.g., 1234567890123456"/>
                            <field name="app_secret" password="True"/>
                        </group>
                        <group>
                            <field name="redirect_uri" readonly="1"/>
                            <field name="token_expiry_date"/>
                            <field name="last_sync_date" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Authentication">
                            <field name="user_access_token" password="True" nolabel="1" placeholder="Long-lived Meta user access token"/>
                        </page>
                        <page string="Connected Pages">
                            <field name="page_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="platform" widget="badge"/>
                                    <field name="category"/>
                                    <field name="form_count"/>
                                    <field name="lead_count"/>
                                    <field name="is_active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_meta_app_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">meta.app.credential</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_app_credential_search"/>
    </record>
</odoo>
