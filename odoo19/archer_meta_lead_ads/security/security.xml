<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_meta_lead_ads" model="ir.module.category">
        <field name="name">Meta Lead Ads</field>
        <field name="description">Meta Lead Ads integration for CRM</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_meta_lead_ads_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="archer_meta_lead_ads.module_category_meta_lead_ads"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_meta_lead_ads_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="archer_meta_lead_ads.module_category_meta_lead_ads"/>
        <field name="implied_ids" eval="[(4, ref('archer_meta_lead_ads.group_meta_lead_ads_user'))]"/>
    </record>

    <record id="rule_meta_app_credential_company" model="ir.rule">
        <field name="name">Meta Credential multi company</field>
        <field name="model_id" ref="model_meta_app_credential"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_meta_page_company" model="ir.rule">
        <field name="name">Meta Page multi company</field>
        <field name="model_id" ref="model_meta_page"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_meta_lead_form_company" model="ir.rule">
        <field name="name">Meta Form multi company</field>
        <field name="model_id" ref="model_meta_lead_form"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_meta_lead_field_mapping_company" model="ir.rule">
        <field name="name">Meta Field Mapping multi company</field>
        <field name="model_id" ref="model_meta_lead_field_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_meta_sync_log_company" model="ir.rule">
        <field name="name">Meta Sync Log multi company</field>
        <field name="model_id" ref="model_meta_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
