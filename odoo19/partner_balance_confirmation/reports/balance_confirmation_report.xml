<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper format: A4 portrait with tight margins -->
    <record id="paperformat_balance_confirmation" model="report.paperformat">
        <field name="name">Balance Confirmation A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">5</field>
        <field name="dpi">110</field>
    </record>

    <!-- Report action -->
    <record id="action_report_balance_confirmation" model="ir.actions.report">
        <field name="name">Balance Confirmation</field>
        <field name="model">balance.confirmation.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_balance_confirmation.report_balance_confirmation_document</field>
        <field name="report_file">partner_balance_confirmation.report_balance_confirmation_document</field>
        <field name="print_report_name">'Balance_Confirmation_' + (object.partner_id.name or 'Partner').replace(' ', '_')</field>
        <field name="paperformat_id" ref="paperformat_balance_confirmation"/>
    </record>
</odoo>
