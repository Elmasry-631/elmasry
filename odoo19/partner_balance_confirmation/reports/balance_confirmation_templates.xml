<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Balance Confirmation Report Template
        ====================================
        Reads values from BOTH `doc` (the wizard record) and `data` dict.
        This dual approach is the most reliable in Odoo 19:
          - `doc` is the standard QWeb variable for the record being printed
          - `data` is the dict passed via report_action(data=...)
        We prefer `doc` (more reliable for TransientModel in Odoo 19) and
        fall back to `data` if the record is no longer accessible.
    -->
    <template id="report_balance_confirmation_document">
        <t t-call="web.html_container">
            <!-- Resolve the wizard record (first doc) -->
            <t t-set="doc" t-value="docs and docs[0] or False"/>

            <!-- Resolve all field values: prefer doc, fall back to data dict -->
            <t t-set="partner_name" t-value="(doc.partner_id.name if doc else '') or (data and data.get('partner_name')) or ''"/>
            <t t-set="confirmation_date" t-value="(doc.confirmation_date and doc.confirmation_date.strftime('%Y-%m-%d') if doc else '') or (data and data.get('confirmation_date')) or ''"/>
            <t t-set="template_type" t-value="(doc.template_type if doc else '') or (data and data.get('template_type')) or 'amdad'"/>
            <t t-set="balance" t-value="(doc.balance if doc else 0.0) or (data and data.get('balance')) or 0.0"/>
            <t t-set="balance_text" t-value="(doc.balance_text if doc else '') or (data and data.get('balance_text')) or ''"/>
            <t t-set="printed_by_name" t-value="(doc.printed_by and doc.printed_by.name if doc else '') or (data and data.get('printed_by')) or ''"/>
            <t t-set="notes" t-value="(doc.notes if doc else '') or (data and data.get('notes')) or ''"/>
            <t t-set="logo_path" t-value="'/partner_balance_confirmation/static/src/img/' + ('namo_logo.png' if template_type == 'namo' else 'amdad_logo.png')"/>

            <t t-call="web.basic_layout">
                <style>
                    @page {
                        size: A4 portrait;
                        margin: 8mm 8mm 8mm 8mm;
                    }

                    body {
                        font-family: 'Amiri', serif;
                        direction: rtl;
                    }

                    .balance_confirmation_page {
                        position: relative;
                        direction: rtl;
                        text-align: right;
                        font-family: 'Amiri', serif;
                        font-size: 13pt;
                        color: #000;
                        line-height: 1.8;
                        min-height: 270mm;
                    }

                    /* Watermark — subtle background logo */
                    .bc_watermark {
                        position: absolute;
                        top: 50mm;
                        left: 0;
                        right: 0;
                        margin: 0 auto;
                        width: 180mm;
                        height: 180mm;
                        z-index: 0;
                        opacity: 0.10;
                        pointer-events: none;
                        text-align: center;
                    }
                    .bc_watermark img {
                        width: 100%;
                        height: 100%;
                        object-fit: contain;
                    }

                    /* All content above watermark */
                    .bc_header,
                    .bc_title,
                    .bc_section,
                    .bc_bottom_logo,
                    .bc_footer {
                        position: relative;
                        z-index: 1;
                    }

                    /* Header — company info right, header logo left */
                    .bc_header {
                        display: table;
                        width: 100%;
                        border-bottom: 1px solid #999;
                        padding-bottom: 3mm;
                        margin-bottom: 5mm;
                    }
                    .bc_header_right {
                        display: table-cell;
                        text-align: right;
                        width: 70%;
                        vertical-align: top;
                        line-height: 1.5;
                        font-size: 11pt;
                    }
                    .bc_header_left {
                        display: table-cell;
                        text-align: left;
                        width: 30%;
                        vertical-align: middle;
                    }
                    .bc_company_name {
                        font-weight: bold;
                        font-size: 13pt;
                        margin-bottom: 1mm;
                    }
                    .bc_header_logo img {
                        height: 20mm;
                        width: auto;
                        max-width: 45mm;
                    }

                    .bc_title {
                        text-align: center;
                        font-size: 16pt;
                        font-weight: bold;
                        margin: 5mm 0 6mm 0;
                        color: #1f3864;
                    }

                    .bc_section {
                        margin-bottom: 4mm;
                        padding: 2mm 0;
                    }

                    .bc_section_title {
                        font-weight: bold;
                        font-size: 14pt;
                        margin-bottom: 2mm;
                        color: #1f3864;
                    }

                    .bc_intro p {
                        margin: 0.5mm 0;
                    }

                    /* System-filled fields — bold black (no highlight, matches original) */
                    .bc_field {
                        color: #000;
                        font-weight: bold;
                    }

                    .bc_amount_text {
                        font-weight: bold;
                        color: #1f3864;
                        margin: 2mm 0;
                        font-size: 13pt;
                    }

                    .bc_note {
                        margin-top: 3mm;
                        font-size: 12pt;
                    }

                    .bc_extra_notes {
                        margin-top: 2mm;
                        background-color: #fffde7;
                        border-right: 3px solid #f0ad4e;
                        padding: 2mm 3mm;
                        font-size: 12pt;
                    }

                    /* Signature block */
                    .bc_signature_block {
                        display: table;
                        width: 100%;
                        margin-top: 5mm;
                        line-height: 2;
                        font-size: 12pt;
                    }
                    .bc_left_sign {
                        display: table-cell;
                        text-align: right;
                        width: 60%;
                    }
                    .bc_right_sign {
                        display: table-cell;
                        text-align: left;
                        width: 40%;
                        font-weight: bold;
                        vertical-align: bottom;
                        padding-bottom: 4mm;
                    }

                    .bc_sign_line {
                        border-top: 2px solid #1f3864;
                        margin-top: 2mm;
                    }

                    .bc_dots {
                        margin: 1mm 0;
                        font-family: 'Courier New', monospace;
                        letter-spacing: 1px;
                        direction: ltr;
                        text-align: right;
                    }

                    .bc_thanks {
                        margin-top: 4mm;
                        text-align: left;
                        padding-left: 30mm;
                    }

                    .bc_signer {
                        margin-top: 4mm;
                        line-height: 2;
                        font-size: 12pt;
                    }

                    /* Bottom company logo — prominent */
                    .bc_bottom_logo {
                        text-align: center;
                        margin-top: 5mm;
                        margin-bottom: 3mm;
                        page-break-inside: avoid;
                    }
                    .bc_bottom_logo img {
                        height: 40mm;
                        width: auto;
                        max-width: 100mm;
                        object-fit: contain;
                    }

                    .bc_footer {
                        text-align: left;
                        font-size: 11pt;
                        color: #444;
                        border-top: 1px solid #ccc;
                        padding-top: 2mm;
                        margin-top: 3mm;
                    }

                    .bc_section,
                    .bc_signature_block,
                    .bc_signer,
                    .bc_bottom_logo {
                        page-break-inside: avoid;
                    }
                </style>

                <div class="page balance_confirmation_page" dir="rtl" style="direction: rtl; text-align: right;">

                    <!-- Background watermark -->
                    <div class="bc_watermark">
                        <img src="/partner_balance_confirmation/static/src/img/watermark.png"/>
                    </div>

                    <!-- Header: company info right, header logo left -->
                    <div class="bc_header">
                        <div class="bc_header_right">
                            <div class="bc_company_name">شركة نمو المتقدمة للصناعة المركز الرئيسي</div>
                            <div>جدة – المدينة الصناعية الثالثة</div>
                            <div>الرمز البريدي 22766</div>
                            <div>رقم المبني 4141</div>
                            <div>الرقم الإضافي 6280</div>
                        </div>
                        <div class="bc_header_left">
                            <div class="bc_header_logo">
                                <img src="/partner_balance_confirmation/static/src/img/header_logo.jpeg"/>
                            </div>
                        </div>
                    </div>

                    <div class="bc_title">كشف حساب إجمالي – مطابقة الرصيد</div>

                    <!-- Date + Recipient line -->
                    <div class="bc_section bc_intro">
                        <p>
                            التاريخ :- <span class="bc_field"><t t-esc="confirmation_date"/></span>
                            <span style="float: left;">السادة : <span class="bc_field"><t t-esc="partner_name"/></span> المحترمون</span>
                        </p>
                        <div style="clear: both;"></div>
                        <p style="padding-right: 5mm; margin-top: 2mm;">تحية طيبة وبعد......</p>
                    </div>

                    <!-- Section 1: طلب مصادقة حساب -->
                    <div class="bc_section">
                        <div class="bc_section_title">طلب مصادقة حساب :</div>
                        <p>تهديكم الشركة أطيب تحياتها وتتمني لكم دوام التقدم والإزدهار،،،</p>
                        <p>
                            بناء علي طلب المراقب المالي للشركة نرجو شاكرين تكرمكم بالمصادقة علي رصيد مدين للشركة كما في تاريخ
                            <span class="bc_field"><t t-esc="confirmation_date"/></span>
                            والبالغ مبلغ
                            <span class="bc_field">( <t t-esc="'%.2f' % balance"/> )</span>
                            ريال رصيد مدين العملة SAR ريال سعودي
                        </p>
                        <p class="bc_amount_text">
                            <t t-esc="balance_text"/>
                        </p>
                        <p class="bc_note">
                            ملاحظة : يعتبر رصيدكم مصادقا عليه كما هو في سجلاتنا مالم نستلم ردا منكم خلال إسبوع من تاريخ استلامكم .
                        </p>
                        <t t-if="notes">
                            <p class="bc_extra_notes">ملاحظات إضافية : <t t-esc="notes"/></p>
                        </t>

                        <div class="bc_signature_block">
                            <div class="bc_left_sign">
                                <div>المستلم :  ..............................</div>
                                <div>تاريخ الاستلام : ....................</div>
                                <div>التوقيع : ...............................</div>
                            </div>
                            <div class="bc_right_sign">المدير المالي</div>
                        </div>
                        <div class="bc_sign_line"></div>
                    </div>

                    <!-- Section 2: المصادقة علي الحساب -->
                    <div class="bc_section">
                        <div class="bc_section_title">المصادقة علي الحساب :</div>
                        <p>
                            السادة :- شركة نمو المتقدمة للصناعة المركز الرئيسي
                            <span style="margin-right: 5mm;">المحترمون</span>
                        </p>
                        <p>
                            نصادق نحن علي ان رصيدكم في سجلاتنا دائن بمبلغ (..............................) فقط لا غير
                            (..................................................................................................)
                        </p>
                        <p>
                            كما هو في تاريخ : <span class="bc_field"><t t-esc="confirmation_date"/></span>
                        </p>
                        <p>ما عدا الاختلافات التالية:-</p>
                        <div class="bc_dots">..........................................................................................</div>
                        <div class="bc_dots">..........................................................................................</div>
                        <p class="bc_thanks">وتقبلوا خالص التحية والاحترام ،،،</p>
                        <div class="bc_signer">
                            <div>الاســــــــــــــم : ..........................................</div>
                            <div>صفتــــــــه : ..........................................</div>
                            <div>التوقيع والختم : ..........................................</div>
                        </div>
                    </div>

                    <!-- Bottom company logo (different per template) -->
                    <div class="bc_bottom_logo">
                        <img t-att-src="logo_path"/>
                    </div>

                    <!-- Footer line -->
                    <div class="bc_footer">
                        طبع بواسطة : <t t-esc="printed_by_name"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
