<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_balance_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">balance.confirmation.wizard.form</field>
        <field name="model">balance.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Balance Confirmation">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="confirmation_date"/>
                            <field name="template_type" widget="radio"/>
                            <field name="printed_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="balance" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="balance_text" colspan="2"/>
                        </group>
                    </group>
                    <group string="Additional Notes">
                        <field name="notes" nolabel="1" colspan="2" placeholder="Notes shown in the confirmation report..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf"
                            type="object"
                            string="Print PDF"
                            class="oe_highlight"/>
                    <button name="action_print_word"
                            type="object"
                            string="Export Word"/>
                    <button name="action_send_email"
                            type="object"
                            string="Send by Email"
                            class="btn-secondary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
