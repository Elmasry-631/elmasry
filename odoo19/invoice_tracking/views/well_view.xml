<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="well_number_action" model="ir.actions.act_window">
        <field name="name">Oil Well</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">oil.well</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_oil_well_tree" model="ir.ui.view">
            <field name="name">oil.well.tree</field>
            <field name="model">oil.well</field>
            <field name="arch" type="xml">
                <list string="Oil Wells">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_oil_well_form" model="ir.ui.view">
            <field name="name">oil.well.form</field>
            <field name="model">oil.well</field>
            <field name="arch" type="xml">
                <form string="Oil Well">
                    <sheet>
                        <group>
                            <field name="name" string="Well Name" placeholder="e.g. Well-01"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
</odoo>
