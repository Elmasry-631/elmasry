<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_check_tracking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.check.tracking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Cheque Tracking" name="check_tracking_cheque_accounts">
                    <setting id="check_tracking_cheque_accounts"
                             string="Cheque Accounts"
                             company_dependent="1"
                             help="Default accounts used when cheque tracking creates journal entries.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="cheque_received_account_id" class="col-lg-4 o_light_label"/>
                                <field name="cheque_received_account_id"/>
                            </div>
                            <div class="row">
                                <label for="cheque_under_collection_account_id" class="col-lg-4 o_light_label"/>
                                <field name="cheque_under_collection_account_id"/>
                            </div>
                            <div class="row">
                                <label for="cheque_issued_account_id" class="col-lg-4 o_light_label"/>
                                <field name="cheque_issued_account_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

