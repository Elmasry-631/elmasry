                <chatter/>

            </form>
        </field>
    </record>

    <record id="view_invoice_tracking_tree" model="ir.ui.view">
        <field name="name">invoice.tracking.tree</field>
        <field name="model">invoice.tracking</field>
        <field name="arch" type="xml">
            <list decoration-info="status == 'new'" decoration-success="status == 'done'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="bill_reference"/>
                <field name="received_date"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'new'"
                       decoration-warning="status in ('received', 'send_to_administration')"
                       decoration-success="status == 'done'"/>
            </list>
        </field>
    </record>
    <record id="add_purchase_order_button_in_invoice_tracking" model="ir.ui.view">
        <field name="name">purchase.order.button.inherit</field>
        <field name="model">invoice.tracking</field>
        <field name="inherit_id" ref="invoice_tracking.view_invoice_tracking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not purchase_id and not purchase_reference">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Purchase</span>
                        <span class="o_stat_text">Order</span>
                    </div>
                </button>
                <button name="action_view_vendor_bill"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="not vendor_bill_id"
                        >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Vendor</span>
                        <span class="o_stat_text">Bill</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
