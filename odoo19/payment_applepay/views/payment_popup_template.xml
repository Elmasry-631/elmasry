<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="payment_applepay_card" priority="30">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <form t-att-action="return_url" class="paymentWidgets" data-brands="APPLEPAY"/>
                </div>
            </div>
            <script t-att-src="'%s/v1/paymentWidgets.js?checkoutId=%s' % (widget_domain, check_out_id)"/>
            <script>
                var wpwlOptions = {
                    applePay: {
                        displayName: "ENSAN",
                        total: { label: "ENSAN" },
                        supportedNetworks: ["mada"]
                    }
                }
            </script>
        </t>
    </template>

    <template id="payment_applepay_card_live" priority="30">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <style>
                        .wpwl-apple-pay-button {
                            -webkit-appearance: -apple-pay-button !important;
                        }
                        .wpwl-group, .wpwl-label-brand, .wpwl-wrapper-brand, .wpwl-wrapper-registration {
                            position: absolute;
                            width: 100%;
                            height: 100%;
                        }
                        .wpwl-apple-pay-button {
                            width: 50%;
                            top: 50%;
                            left: 50%;
                            display: block;
                            margin: auto;
                            height: 300px;
                        }
                    </style>
                    <form t-att-action="return_url" class="paymentWidgets" data-brands="APPLEPAY"/>
                </div>
            </div>
            <script t-att-src="'%s/v1/paymentWidgets.js?checkoutId=%s' % (widget_domain, check_out_id)"/>
            <script>
                var wpwlOptions = {
                    applePay: {
                        displayName: "ENSAN",
                        total: { label: "ENSAN" },
                        supportedNetworks: ["mada"]
                    }
                }
            </script>
        </t>
    </template>

</odoo>
