<odoo>



    <record id="paperformat_contract" model="report.paperformat">
        <field name="name">Contract Paper Format</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
    </record>
    <!-- Report Action -->
    <record id="action_report_invoice_saudi" model="ir.actions.report">
        <field name="name">Saudi Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">saudi_tax_invoice.stock_movement_report_template</field>
        <field name="report_file">saudi_tax_invoice.stock_movement_report_template</field>
        <field name="print_report_name">'%s' % (object.name or 'Invoice')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="saudi_tax_invoice.paperformat_contract"/>
    </record>



    <!-- QWeb Template -->
    <template id="stock_movement_report_template">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div style="">
                        <div class="row mb-3" >
                            <!-- بيانات الشركة (يمين) -->
                            <div class="col-3 text-start">
                                <img t-if="o.company_id.logo" t-att-src="'data:image/png;base64,%s' % o.company_id.logo.decode('utf-8')"
                                     alt="Company Logo" style="max-height:3000px; max-width:100%; border-radius:4px;"/>
                            </div>
                            <div class="col-9 text-end">
                                <h4>
                                    <strong t-field="o.company_id.name"/>
                                </h4>
                                <p>
                                    <strong>الرقم الضريبي:</strong>
                                    <span t-field="o.company_id.vat"/>
                                </p>
                                <p>
                                    <strong>السجل التجاري:</strong>
                                    <span t-esc="o.company_id.company_registry or ''"/>
                                </p>
                            </div>
                        </div>

                        <!-- Header -->
                        <div style="
                        border: 1px solid #ccc;
                        border-radius: 6px;
                        padding: 16px 20px;
                        margin-bottom: 18px;
                        display: flex;
                        flex-direction: column;
                        gap: 16px;
                        text-align: right;
                    ">

                            <!-- العنوان -->
                            <div style="text-align: center; border-bottom: 1px solid #ddd; padding-bottom: 6px;">
                                <h2 style="margin: 0; font-size: 20px;"><strong>فاتورة ضريبية</strong></h2>
                            </div>

                            <!-- البيانات -->
                            <div style="direction: rtl; text-align: right; width: 100%; margin-top: 10px;">

                                <!-- بيانات العميل -->
                                <div style="display: inline-block; width: 48%; vertical-align: top;">
                                    <p style="margin: 4px 0;"><strong>اسم العميل:</strong> <span t-field="o.partner_id.name"/></p>
                                    <p style="margin: 4px 0;"><strong>الرقم الضريبي:</strong> <span t-field="o.partner_id.vat"/></p>
                                    <p style="margin: 4px 0;"><strong>العنوان:</strong> <span t-field="o.partner_id.street"/>
                                    <span t-field="o.partner_id.street2"/><br/>
                                    <span t-field="o.partner_id.city"/>
                                    <span t-field="o.partner_id.country_id.name"/>
                                    </p>
                                    <p style="margin: 4px 0;"><strong>الهاتف:</strong> <span t-field="o.partner_id.phone"/></p>
                                </div>

                                <!-- بيانات الفاتورة -->
                                <div style="display: inline-block; width: 48%; vertical-align: top;">
                                    <p style="margin: 4px 0;"><strong>رقم الفاتورة:</strong> <span t-field="o.name"/></p>
                                    <p style="margin: 4px 0;"><strong>تاريخ الفاتورة:</strong> <span t-field="o.invoice_date"/></p>
                                    <p style="margin: 4px 0;"><strong>تاريخ الاستحقاق:</strong> <span t-field="o.invoice_date_due"/></p>
                                    <p style="margin: 4px 0;"><strong>تاريخ التوريد:</strong> <span t-field="o.invoice_date_due"/></p>
                                    <p style="margin: 4px 0;"><strong>المصدر:</strong> <span t-field="o.invoice_origin"/></p>
                                </div>

                            </div>


                        </div>

                        <!-- Table -->
                        <table class="table table-sm table-bordered mt-4" style="width:100%; border-collapse: collapse; font-size: 12px;">
                            <thead>
                                <tr style="background: #f7f7f7;">
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">تسلسل</div>
                                    </th>


                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">الوصف</div>
                                    </th>
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">الكمية</div>
                                    </th>
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">سعر الوحدة</div>
                                    </th>
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">الخصم</div>
                                    </th>
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">الضريبة</div>
                                    </th>
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">المبلغ قبل الضريبة</div>
                                    </th>
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">مبلغ الضريبة</div>
                                    </th>
                                    <th style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <div style="font-weight:600;">المجموع</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.invoice_line_ids" t-as="line">
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <span t-esc="line.sequence"/>
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <span t-field="line.discount"/>
%
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <span t-esc="'%.2f' % (line.tax_ids and line.tax_ids[0].amount or 0)"/>
%
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <span t-esc="line.price_subtotal"/>
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center;">
                                        <span t-esc="'%.2f' % (line.price_total - line.price_subtotal)"/>
                                    </td>
                                    <td style="padding:6px; border: 1px solid #ccc; text-align:center; font-weight:600;">
                                        <span t-field="line.price_total"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

