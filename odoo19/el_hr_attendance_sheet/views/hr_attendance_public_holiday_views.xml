<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ ACTION ============ -->
    <record id="action_hr_attendance_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">hr.attendance.public.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new public holiday</p>
            <p>Define public holidays that affect overtime calculation.</p>
        </field>
    </record>

    <!-- ============ LIST ============ -->
    <record id="view_hr_attendance_public_holiday_list" model="ir.ui.view">
        <field name="name">hr.attendance.public.holiday.list</field>
        <field name="model">hr.attendance.public.holiday</field>
        <field name="arch" type="xml">
            <list string="Public Holidays">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'cancelled'"
                       decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="view_hr_attendance_public_holiday_form" model="ir.ui.view">
        <field name="name">hr.attendance.public.holiday.form</field>
        <field name="model">hr.attendance.public.holiday</field>
        <field name="arch" type="xml">
            <form string="Public Holiday">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft','active')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. National Day"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees / Departments / Tags" name="lines">
                            <field name="line_ids">
                                <list string="Lines" editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="department_id"/>
                                    <field name="employee_tag_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="view_hr_attendance_public_holiday_search" model="ir.ui.view">
        <field name="name">hr.attendance.public.holiday.search</field>
        <field name="model">hr.attendance.public.holiday</field>
        <field name="arch" type="xml">
            <search string="Search Public Holidays">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <filter name="filter_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
</odoo>
