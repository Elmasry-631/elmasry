<odoo>
    <record id="loan_form_view" model="ir.ui.view">
        <field name="name">loan.form.view</field>
        <field name="model">loan</field>
        <field name="arch" type="xml">
            <form string="Loans">
                <header>
                    <button name="compute_installments" type="object" string="Compute Installments" class="btn-primary"
                            invisible="state != 'draft'" groups="loan_management.group_loan_manager"/>
                    <button name="compute_installments" type="object" string="Compute Installments" class="btn-secondary"
                            invisible="state != 'waiting'" groups="loan_management.group_loan_manager"/>
                    <button name="button_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state in ('approved', 'draft', 'paid')" groups="loan_management.group_loan_manager"/>
                    <button name="button_reject" type="object" string="Reject" invisible="state in ('rejected', 'draft', 'paid')"
                            groups="loan_management.group_loan_manager"/>
                    <button name="button_draft" type="object" string="Reset to draft" invisible="state in ('draft', 'paid')"
                            groups="loan_management.group_loan_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft, approved, rejected, paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="employee_id" widget="many2one_avatar_user" placeholder="Employee..." readonly="state != 'draft'"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="installments_count" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <field name="reason" placeholder="Loan Reason..." readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page name="loan_lines" string="Loan Installments">
                            <field name="loan_lines" widget="one2many_list">
                                <list editable="top">
                                    <field name="loan_id" column_invisible="1"/>
                                    <field name="payment_date" readonly="loan_state not in ['draft', 'waiting']"/>
                                    <field name="amount" readonly="state == 'paid'"/>
                                    <field name="note" readonly="loan_state not in ['draft', 'waiting']"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" decoration-danger="state == 'unpaid'" decoration-success="state == 'paid'" readonly="loan_state not in ['draft', 'waiting']"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="loan_list_view" model="ir.ui.view">
        <field name="name">loan.list.view</field>
        <field name="model">loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"
                       decoration-info="state == 'approved'" decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'draft'" decoration-warning="state == 'waiting'"/>
            </list>
        </field>
    </record>

    <record id="loan_view_search" model="ir.ui.view">
            <field name="name">loan.search</field>
            <field name="model">loan</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="active_loans" string="Active" domain="[('state', 'in', ['draft', 'waiting', 'approved'])]"/>
                    <filter name="rejected_loans" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                    <filter name="paid_loans" string="Paid" domain="[('state', '=', 'paid')]"/>
                </search>
            </field>
    </record>
    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="loan_action_window">
        <field name="name">Loans</field>
        <field name="res_model">loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'search_default_active_loans': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No loans!
            </p>
        </field>
    </record>

    <!-- Installment Lines view -->
    <record id="loan_line_list_view" model="ir.ui.view">
        <field name="name">loan.line.list.view</field>
        <field name="model">loan.line</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="payment_date"/>
                <field name="loan_id"/>
                <field name="employee_id"/>
                <field name="amount"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" decoration-danger="state == 'unpaid'" decoration-success="state == 'paid'"/>
                <field name="loan_state"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="loan_line_action_window">
        <field name="name">Payment Schedule</field>
        <field name="res_model">loan.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payment schedules found!
            </p>
        </field>
    </record>

    <menuitem id="menu_loan_root"
              name="Loans Management"
              action="loan_action_window"
              web_icon="loan_management,static/description/icon.png"/>

    <menuitem id="menu_loan_installment_main"
              name="Installments"
              parent="menu_loan_root"
              action="loan_action_window"
              sequence="10"/>

    <menuitem id="menu_vehicle_installment_lines"
              name="Payment Schedule"
              parent="menu_loan_root"
              action="loan_line_action_window"
              sequence="20"/>
</odoo>
