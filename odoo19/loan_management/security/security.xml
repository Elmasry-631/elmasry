<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="loan_management.module_category_loan" model="ir.module.category">
            <field name="name">Loan</field>
            <field name="sequence">11</field>
            <field name="visible" eval="True"/>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_loan_management">
            <field name="name">Loan Management</field>
            <field name="sequence">9</field>
            <field name="category_id" ref="loan_management.module_category_loan"/>
        </record>

        <record id="group_loan_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="loan_management.res_groups_privilege_loan_management"/>
        </record>

        <record id="group_loan_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="loan_management.res_groups_privilege_loan_management"/>
        </record>

        <record id="loan_rule" model="ir.rule">
            <field name="name">Loan rule</field>
            <field name="model_id" ref="model_loan"/>
            <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
            <field name="domain_force">['|', ('employee_id', 'in', user.employee_id.child_ids.ids),
                ('employee_id.user_id', '=', user.id)]
            </field>
        </record>

        <record id="loan_see_own_company" model="ir.rule">
            <field name="name">Loans: Only see loans of own company</field>
            <field name="model_id" ref="model_loan"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_loan_user')), (4, ref('group_loan_manager'))]"/>
        </record>
    </data>
</odoo>