<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="vehicle_installment.module_category_vehicle_installment" model="ir.module.category">
            <field name="name">Vehicle Installment</field>
            <field name="sequence">12</field>
            <field name="visible" eval="True"/>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_vehicle_installment">
            <field name="name">Vehicle Installment Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="vehicle_installment.module_category_vehicle_installment"/>
        </record>

        <record id="group_vehicle_installment_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="vehicle_installment.res_groups_privilege_vehicle_installment"/>
        </record>

        <record id="group_vehicle_installment_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="vehicle_installment.res_groups_privilege_vehicle_installment"/>
        </record>

        <record id="vehicle_installment_rule" model="ir.rule">
            <field name="name">Vehicle Installment rule</field>
            <field name="model_id" ref="model_vehicle_installment"/>
            <field name="groups" eval="[(4, ref('group_vehicle_installment_user'))]"/>
            <field name="domain_force">['|', ('employee_id', 'in', user.employee_id.child_ids.ids),
                ('employee_id.user_id', '=', user.id)]
            </field>
        </record>

        <record id="vehicle_installment_see_own_company" model="ir.rule">
            <field name="name">Vehicle Installments: Only see installments of own company</field>
            <field name="model_id" ref="model_vehicle_installment"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_vehicle_installment_user')), (4, ref('group_vehicle_installment_manager'))]"/>
        </record>

        <record id="vehicle_installment_line_see_own_company" model="ir.rule">
            <field name="name">Vehicle Installment Lines: Only see lines of own company</field>
            <field name="model_id" ref="model_vehicle_installment_line"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_vehicle_installment_user')), (4, ref('group_vehicle_installment_manager'))]"/>
        </record>
    </data>
</odoo>
