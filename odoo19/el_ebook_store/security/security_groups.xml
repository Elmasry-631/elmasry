<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ebook_store" model="ir.module.category">
        <field name="name">E-Book Store</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_ebook_user" model="res.groups">
        <field name="name">E-Book: User (Read Only)</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_ebook_manager" model="res.groups">
        <field name="name">E-Book: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_ebook_user'))]"/>
    </record>
</odoo>
