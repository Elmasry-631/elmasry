<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ebook_access_log_list" model="ir.ui.view">
        <field name="name">ebook.access.log.list</field>
        <field name="model">ebook.access.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="access_date"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="action_ebook_access_log" model="ir.actions.act_window">
        <field name="name">Access Logs</field>
        <field name="res_model">ebook.access.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
