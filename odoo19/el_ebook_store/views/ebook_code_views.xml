<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ebook_code_form" model="ir.ui.view">
        <field name="name">ebook.code.form</field>
        <field name="model">ebook.code</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reset" string="Reset" type="object" class="btn-secondary" invisible="state == 'available'"/>
                    <button name="action_expire" string="Expire" type="object" class="btn-danger" invisible="state in ('expired','available')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_tmpl_id"/>
                            <field name="generated_by"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="order_id"/>
                            <field name="max_access"/>
                            <field name="access_count"/>
                            <field name="used_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ebook_code_list" model="ir.ui.view">
        <field name="name">ebook.code.list</field>
        <field name="model">ebook.code</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'"
                  decoration-warning="state == 'assigned'"
                  decoration-danger="state == 'used'"
                  decoration-muted="state == 'expired'">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="access_count"/>
                <field name="max_access"/>
                <field name="generated_by"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_ebook_code_search" model="ir.ui.view">
        <field name="name">ebook.code.search</field>
        <field name="model">ebook.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="partner_id"/>
                <filter name="filter_available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="filter_assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <filter name="filter_used" string="Used" domain="[('state', '=', 'used')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group name="group_by">
                    <filter name="group_by_product" string="E-Book" context="{'group_by': 'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ebook_code" model="ir.actions.act_window">
        <field name="name">E-Book Codes</field>
        <field name="res_model">ebook.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
