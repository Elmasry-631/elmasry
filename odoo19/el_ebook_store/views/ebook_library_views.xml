<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ebook_library_form" model="ir.ui.view">
        <field name="name">ebook.library.form</field>
        <field name="model">ebook.library</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="code_id"/>
                        </group>
                        <group>
                            <field name="order_id"/>
                            <field name="state"/>
                            <field name="purchase_date"/>
                            <field name="last_access"/>
                            <field name="access_count"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ebook_library_list" model="ir.ui.view">
        <field name="name">ebook.library.list</field>
        <field name="model">ebook.library</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="code_id"/>
                <field name="state"/>
                <field name="purchase_date"/>
                <field name="last_access"/>
                <field name="access_count"/>
            </list>
        </field>
    </record>

    <record id="action_ebook_library" model="ir.actions.act_window">
        <field name="name">Customer Libraries</field>
        <field name="res_model">ebook.library</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
