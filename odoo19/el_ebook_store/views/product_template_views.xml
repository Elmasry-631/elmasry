<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_ebook" model="ir.ui.view">
        <field name="name">product.template.form.ebook</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="E-Book" name="ebook_info" invisible="not is_ebook">
                    <group>
                        <group string="Book Info">
                            <field name="is_ebook"/>
                            <field name="ebook_author"/>
                            <field name="ebook_pages"/>
                            <field name="ebook_isbn"/>
                            <field name="ebook_access_type" widget="radio"/>
                        </group>
                        <group string="Files">
                            <field name="ebook_file" filename="ebook_filename"/>
                            <field name="ebook_filename" invisible="1"/>
                            <field name="ebook_sample" filename="ebook_sample_filename"/>
                            <field name="ebook_sample_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Code Statistics">
                        <group>
                            <field name="ebook_total_codes"/>
                            <field name="ebook_codes_used"/>
                            <field name="ebook_codes_available"/>
                        </group>
                        <group>
                            <button name="%(el_ebook_store.action_generate_codes_wizard)d"
                                    type="action"
                                    string="Generate Codes"
                                    class="btn-primary"
                                    icon="fa-key"
                                    invisible="not is_ebook"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
