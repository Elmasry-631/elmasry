<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category for Commissions -->
        <record id="module_category_commissions" model="ir.module.category">
            <field name="name">Commissions</field>
            <field name="description">Helps you manage commission types and calculations</field>
            <field name="sequence">25</field>
        </record>

        <!-- Privilege: Commission -->
        <record id="privilege_commissions" model="res.groups.privilege">
            <field name="name">Commissions</field>
            <field name="description">Helps you manage commission types and calculations</field>
            <field name="category_id" ref="module_category_commissions"/>
            <field name="sequence">25</field>
        </record>

        <!-- Group: Commission Type User (Read/Write) -->
        <record id="group_commission_user" model="res.groups">
            <field name="name">Commission Type User</field>
            <field name="privilege_id" ref="privilege_commissions"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Group: Commission Type Manager (Full Access) -->
        <record id="group_commission_manager" model="res.groups">
            <field name="name">Commission Type Manager</field>
            <field name="privilege_id" ref="privilege_commissions"/>
            <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>