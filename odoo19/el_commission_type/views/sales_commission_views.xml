<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="view_sales_commission_tree" model="ir.ui.view">
        <field name="name">sales.commission.tree</field>
        <field name="model">sales.commission</field>
        <field name="arch" type="xml">
            <list string="Commissions" default_order="id desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="team_member_type"/>
                <field name="commission_percentage" widget="percentage"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_sales_commission_form" model="ir.ui.view">
        <field name="name">sales.commission.form</field>
        <field name="model">sales.commission</field>
        <field name="arch" type="xml">
            <form string="Commission">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="o_field_char" style="color: #6C757D; font-size: 24px;"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Commission Information">
                            <field name="partner_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="team_member_type"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="commission_percentage"
                                   widget="percentage"
                                   string="Commission Percentage (%)"/>
                        </group>
                        <group string="Company Information">
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_sales_commission_search" model="ir.ui.view">
        <field name="name">sales.commission.search</field>
        <field name="model">sales.commission</field>
        <field name="arch" type="xml">
            <search string="Search Commissions">
                <field name="partner_id" string="Partner"/>
                <field name="team_member_type" string="Team Member Type"/>

                <filter string="Team Member Type"
                        name="group_by_type"
                        context="{'group_by': 'team_member_type'}"/>
                <filter string="Partner"
                        name="group_by_partner"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_sales_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">sales.commission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Commission!
            </p>
            <p>
                Select a partner, the team member type and the commission percentage.
            </p>
        </field>
    </record>

</odoo>
