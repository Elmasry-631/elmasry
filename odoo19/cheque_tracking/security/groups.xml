<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cheque_tracking" model="ir.module.category">
        <field name="name">Cheque Tracking</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_cheque_tracking" model="res.groups.privilege">
        <field name="name">Cheque Tracking</field>
        <field name="category_id" ref="module_category_cheque_tracking"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_cheque_user" model="res.groups">
        <field name="name">Cheque User</field>
        <field name="privilege_id" ref="res_groups_privilege_cheque_tracking"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cheque_manager" model="res.groups">
        <field name="name">Cheque Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_cheque_tracking"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_cheque_user'))]"/>
    </record>

    <record id="group_cheque_admin" model="res.groups">
        <field name="name">Cheque Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_cheque_tracking"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_cheque_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
