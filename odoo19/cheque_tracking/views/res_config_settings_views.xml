<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_cheque_tracking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cheque.tracking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Cheque Tracking" name="cheque_tracking_settings">
                    <setting id="cheque_tracking_accounts"
                             string="Cheque Accounts"
                             company_dependent="1"
                             help="Default accounts used when cheque tracking creates journal entries.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="cheque_received_account_id" class="col-lg-5 o_light_label"/>
                                <field name="cheque_received_account_id"/>
                            </div>
                            <div class="row">
                                <label for="cheque_under_collection_account_id" class="col-lg-5 o_light_label"/>
                                <field name="cheque_under_collection_account_id"/>
                            </div>
                            <div class="row">
                                <label for="cheque_issued_account_id" class="col-lg-5 o_light_label"/>
                                <field name="cheque_issued_account_id"/>
                            </div>
                            <div class="row">
                                <label for="cheque_bank_charges_account_id" class="col-lg-5 o_light_label"/>
                                <field name="cheque_bank_charges_account_id"/>
                            </div>
                            <div class="row">
                                <label for="cheque_penalty_income_account_id" class="col-lg-5 o_light_label"/>
                                <field name="cheque_penalty_income_account_id"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="cheque_tracking_rules"
                             string="Cheque Lifecycle Rules"
                             company_dependent="1"
                             help="Rules for post-dated reminders, stale cheque detection, re-deposit attempts, and issued cheque approvals.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="cheque_stale_months" class="col-lg-5 o_light_label"/>
                                <field name="cheque_stale_months"/>
                            </div>
                            <div class="row">
                                <label for="cheque_pdc_reminder_days" class="col-lg-5 o_light_label"/>
                                <field name="cheque_pdc_reminder_days"/>
                            </div>
                            <div class="row">
                                <label for="cheque_max_redeposit_attempts" class="col-lg-5 o_light_label"/>
                                <field name="cheque_max_redeposit_attempts"/>
                            </div>
                            <div class="row">
                                <label for="cheque_approval_threshold" class="col-lg-5 o_light_label"/>
                                <field name="cheque_approval_threshold"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
