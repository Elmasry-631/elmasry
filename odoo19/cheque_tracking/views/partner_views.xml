<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_cheque_tracking" model="ir.ui.view">
        <field name="name">res.partner.form.cheque.tracking</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_received_cheques" type="object" class="oe_stat_button" icon="fa-money" groups="cheque_tracking.group_cheque_user">
                    <field name="received_cheque_count" widget="statinfo" string="Received Cheques"/>
                </button>
                <button name="action_view_issued_cheques" type="object" class="oe_stat_button" icon="fa-credit-card" groups="cheque_tracking.group_cheque_user">
                    <field name="issued_cheque_count" widget="statinfo" string="Issued Cheques"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

