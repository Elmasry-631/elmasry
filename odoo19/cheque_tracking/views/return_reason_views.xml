<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cheque_return_reason_list" model="ir.ui.view">
        <field name="name">cheque.return.reason.list</field>
        <field name="model">cheque.return.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cheque_return_reason_form" model="ir.ui.view">
        <field name="name">cheque.return.reason.form</field>
        <field name="model">cheque.return.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="description"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cheque_return_reason" model="ir.actions.act_window">
        <field name="name">Return Reasons</field>
        <field name="res_model">cheque.return.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

