<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cheque_register" model="ir.actions.report">
        <field name="name">Cheque Register</field>
        <field name="model">cheque.cheque</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cheque_tracking.report_cheque_register_document</field>
        <field name="report_file">cheque_tracking.report_cheque_register_document</field>
        <field name="binding_model_id" ref="model_cheque_cheque"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cheque_register_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Cheque Register</h2>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Type</th>
                                <th>Number</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th>Partner</th>
                                <th>Bank</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-field="doc.name"/></td>
                                <td><span t-field="doc.cheque_type"/></td>
                                <td><span t-field="doc.cheque_number"/></td>
                                <td><span t-field="doc.cheque_date"/></td>
                                <td><span t-field="doc.due_date"/></td>
                                <td><span t-field="doc.partner_id"/></td>
                                <td><span t-field="doc.bank_id"/></td>
                                <td><span t-field="doc.state"/></td>
                                <td class="text-end"><span t-field="doc.amount"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>

