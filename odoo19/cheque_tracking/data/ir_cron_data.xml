<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_cheque_pdc_maturity" model="ir.cron">
        <field name="name">Cheque Tracking: PDC Maturity Reminder</field>
        <field name="model_id" ref="model_cheque_cheque"/>
        <field name="state">code</field>
        <field name="code">model._cron_pdc_maturity_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_cheque_stale_detection" model="ir.cron">
        <field name="name">Cheque Tracking: Stale Cheque Detection</field>
        <field name="model_id" ref="model_cheque_cheque"/>
        <field name="state">code</field>
        <field name="code">model._cron_stale_cheque_detection()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>

