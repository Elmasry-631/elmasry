<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cheque_print_wizard_form" model="ir.ui.view">
        <field name="name">cheque.print.wizard.form</field>
        <field name="model">cheque.print.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="template"/>
                    <field name="cheque_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cheque_print_wizard" model="ir.actions.act_window">
        <field name="name">Print Cheques</field>
        <field name="res_model">cheque.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_cheque_cheque"/>
        <field name="binding_view_types">list</field>
        <field name="context">{'default_cheque_ids': active_ids}</field>
    </record>
</odoo>

