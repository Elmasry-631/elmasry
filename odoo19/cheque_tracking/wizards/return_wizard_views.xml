<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cheque_return_wizard_form" model="ir.ui.view">
        <field name="name">cheque.return.wizard.form</field>
        <field name="model">cheque.return.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="cheque_id" readonly="1"/>
                    <field name="return_date"/>
                    <field name="return_reason_id"/>
                    <field name="bank_charges"/>
                    <field name="penalty_amount"/>
                    <field name="create_activity"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_return_cheque" type="object" string="Submit Return" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

