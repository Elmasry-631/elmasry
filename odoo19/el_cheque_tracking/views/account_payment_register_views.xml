<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_payment_register_form_cheque" model="ir.ui.view">
        <field name="name">account.payment.register.form.cheque</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="Cheque Tracking">
                    <field name="cheque_id"
                           domain="[('partner_id', '=', partner_id)]"
                           invisible="payment_method_code != 'cheque_in' and payment_method_code != 'cheque_out'"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
