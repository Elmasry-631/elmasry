<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="cheque_deposit_list" model="ir.ui.view">
        <field name="name">cheque.deposit.list</field>
        <field name="model">cheque.deposit</field>
        <field name="arch" type="xml">
            <list string="Deposits">
                <field name="name"/>
                <field name="deposit_date"/>
                <field name="bank_journal_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="cheque_deposit_form" model="ir.ui.view">
        <field name="name">cheque.deposit.form</field>
        <field name="model">cheque.deposit</field>
        <field name="arch" type="xml">
            <form string="Deposit">
                <header>
                    <button name="action_confirm" string="Confirm Deposit" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="el_cheque_tracking.group_cheque_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'"
                            groups="el_cheque_tracking.group_cheque_manager"/>
                    <button name="action_print_slip" string="Print Deposit Slip" type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="deposit_date" readonly="state != 'draft'"/>
                            <field name="bank_journal_id" readonly="state != 'draft'"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cheques">
                            <field name="cheque_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="name"/>
                                    <field name="cheque_number"/>
                                    <field name="partner_id"/>
                                    <field name="bank_id"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="cheque_deposit_search" model="ir.ui.view">
        <field name="name">cheque.deposit.search</field>
        <field name="model">cheque.deposit</field>
        <field name="arch" type="xml">
            <search string="Deposits">
                <field name="name"/>
                <field name="bank_journal_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group>
                    <filter string="Bank Journal" name="bank"
                            context="{'group_by': 'bank_journal_id'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_cheque_deposit" model="ir.actions.act_window">
        <field name="name">Cheque Deposits</field>
        <field name="res_model">cheque.deposit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new cheque deposit batch</p>
        </field>
    </record>

</odoo>
