<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_payment_form_cheque" model="ir.ui.view">
        <field name="name">account.payment.form.cheque</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Cheque Tracking" invisible="cheque_id == False">
                    <field name="cheque_id"
                           domain="[('partner_id', '=', partner_id),
                                    ('cheque_type', '=', 'received' if payment_type == 'inbound' else 'issued')]"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
