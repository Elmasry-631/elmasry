<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_cheque_register" model="ir.actions.report">
        <field name="name">Cheque Register</field>
        <field name="model">cheque.cheque</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">el_cheque_tracking.report_cheque_register_document</field>
        <field name="report_file">el_cheque_tracking.report_cheque_register_document</field>
        <field name="print_report_name">'Cheque_Register_%s' % (object.name or 'cheque')</field>
        <field name="binding_model_id" ref="model_cheque_cheque"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cheque_register_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mt-3 mb-4">
                        <h2>Cheque Register</h2>
                    </div>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Type</th>
                                <th>Number</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th>Partner</th>
                                <th>Bank</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc" t-key="doc.id">
                                <td><t t-esc="doc.name"/></td>
                                <td><t t-esc="doc.cheque_type"/></td>
                                <td><t t-esc="doc.cheque_number"/></td>
                                <td><t t-esc="doc.cheque_date"/></td>
                                <td><t t-esc="doc.due_date or ''"/></td>
                                <td><t t-esc="doc.partner_id.name"/></td>
                                <td><t t-esc="doc.bank_id.name"/></td>
                                <td><t t-esc="doc.state"/></td>
                                <td class="text-end">
                                    <t t-esc="doc.amount"
                                       t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
