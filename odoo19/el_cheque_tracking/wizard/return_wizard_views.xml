<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cheque_return_wizard_form" model="ir.ui.view">
        <field name="name">cheque.return.wizard.form</field>
        <field name="model">cheque.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Cheque">
                <group>
                    <group>
                        <field name="cheque_id" readonly="1"/>
                        <field name="return_date"/>
                        <field name="return_reason_id"/>
                    </group>
                    <group>
                        <field name="bank_charges"/>
                        <field name="penalty_amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group string="Notes">
                    <field name="notes" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_submit_return" string="Submit Return"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cheque_return_wizard" model="ir.actions.act_window">
        <field name="name">Return Cheque</field>
        <field name="res_model">cheque.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
