<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- PDC maturity reminder: daily at 08:00 -->
    <record id="cron_pdc_maturity_reminder" model="ir.cron">
        <field name="name">Cheque: PDC Maturity Reminder</field>
        <field name="model_id" ref="model_cheque_cheque"/>
        <field name="state">code</field>
        <field name="code">model._cron_pdc_maturity_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Stale cheque detection: daily at 09:00 -->
    <record id="cron_stale_cheque_detection" model="ir.cron">
        <field name="name">Cheque: Stale Cheque Detection</field>
        <field name="model_id" ref="model_cheque_cheque"/>
        <field name="state">code</field>
        <field name="code">model._cron_stale_cheque_detection()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
