<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <!-- Reuses el_construction_management's User / Manager groups so tendering
         permissions stay unified with the rest of the construction suite. -->

    <record id="rule_tender_opportunity_company" model="ir.rule">
        <field name="name">Tender Opportunity Company</field>
        <field name="model_id" ref="model_el_construction_tender_opportunity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('el_construction_management.group_construction_user'))]"/>
    </record>
    <record id="rule_tender_line_company" model="ir.rule">
        <field name="name">Tender Line Company</field>
        <field name="model_id" ref="model_el_construction_tender_line"/>
        <field name="domain_force">[('tender_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('el_construction_management.group_construction_user'))]"/>
    </record>
    <record id="rule_tender_rfq_company" model="ir.rule">
        <field name="name">Tender RFQ Company</field>
        <field name="model_id" ref="model_el_construction_tender_rfq"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('el_construction_management.group_construction_user'))]"/>
    </record>
    <record id="rule_tender_rfq_line_company" model="ir.rule">
        <field name="name">Tender RFQ Line Company</field>
        <field name="model_id" ref="model_el_construction_tender_rfq_line"/>
        <field name="domain_force">[('rfq_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('el_construction_management.group_construction_user'))]"/>
    </record>
    <record id="rule_tender_rfq_vendor_company" model="ir.rule">
        <field name="name">Tender RFQ Vendor Company</field>
        <field name="model_id" ref="model_el_construction_tender_rfq_vendor"/>
        <field name="domain_force">[('rfq_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('el_construction_management.group_construction_user'))]"/>
    </record>
    <record id="rule_tender_rfq_bid_line_company" model="ir.rule">
        <field name="name">Tender RFQ Bid Line Company</field>
        <field name="model_id" ref="model_el_construction_tender_rfq_bid_line"/>
        <field name="domain_force">[('rfq_vendor_id.rfq_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('el_construction_management.group_construction_user'))]"/>
    </record>
</data>
</odoo>
