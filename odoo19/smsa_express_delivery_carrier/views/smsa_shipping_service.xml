<odoo>
    <data>
    
    <record id="smsa_delivery_carrier" model="ir.ui.view">
        <field name="name">SMSA Delivery Carrier</field>
        <field name="model">delivery.carrier</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SMSA Credentials" invisible="delivery_type != 'smsa'">
                    <group>
                        <group>
                            <field name="smsa_test_passkey"  required="delivery_type == 'smsa' and prod_environment == False"/>
                        </group>     
                        <group>
                            <field name="smsa_prod_passkey" required="delivery_type == 'smsa' and prod_environment != False"/>
                        </group>                                            
                    </group>                    
                </page>
            </xpath>
            <xpath expr="//group[@name='Delivery Setting']" position="after">
              <group string="SMSA Express Information" invisible="delivery_type != 'smsa'">
                    <field name="fixed_price" required="delivery_type == 'smsa'"/>
                    <field name="smsa_label_type" required="delivery_type == 'smsa'"/>
                    <field name="is_cod" required="delivery_type == 'smsa'" />
                    <field name="smsa_service_type" required="delivery_type == 'smsa'"/>
                    <field name="smsa_return_service_type" required="delivery_type == 'smsa'"/>
              </group>  
          </xpath>            
        </field>
    </record>
    
     <record id="smsa_stock_picking" model="ir.ui.view">
        <field name="name">SMSA Stock Picking</field>
        <field name="model">stock.picking</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_type']" position="after">
                <field name="smsa_sawb" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field 
                name="wk_content_description" invisible="delivery_type != 'smsa'" readonly="label_genrated"/>
            </xpath>
        </field>
    </record>
     
    </data>
</odoo>
