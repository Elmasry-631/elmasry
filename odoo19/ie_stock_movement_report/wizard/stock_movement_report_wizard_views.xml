<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Stock Movement Report Wizard — Form View
        ========================================
        LAW 6: uses invisible= (not attrs=)
        LAW 12: uses <sheet> + <group> layout, fa-* icons on buttons
    -->
    <record id="view_stock_movement_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.movement.report.wizard.form</field>
        <field name="model">stock.movement.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Movement Report">
                <sheet>
                    <group>
                        <group string="Period" name="period_group">
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group string="Filters (optional)" name="filters_group">
                            <field name="warehouse_id"/>
                            <field name="location_id"
                                   domain="[('usage', 'in', ('internal', 'transit'))]"/>
                            <field name="product_id"/>
                            <field name="categ_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" type="object"
                            string="Print PDF"
                            icon="fa-print"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"
                            icon="fa-times"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_movement_report_wizard" model="ir.actions.act_window">
        <field name="name">Stock Movement Report</field>
        <field name="res_model">stock.movement.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
