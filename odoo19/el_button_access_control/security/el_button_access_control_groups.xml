<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_button_access_user" model="res.groups">
        <field name="name">Button Access: User (View Rules)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_button_access_manager" model="res.groups">
        <field name="name">Button Access: Manager (Configure Rules)</field>
        <field name="implied_ids" eval="[(4, ref('group_button_access_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
