<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Form View ─────────────────────────────────────────────── -->
    <record id="view_el_button_access_rule_form" model="ir.ui.view">
        <field name="name">el.button.access.rule.form</field>
        <field name="model">el.button.access.rule</field>
        <field name="arch" type="xml">
            <form string="Button Access Rule">
                <header>
                    <button name="action_scan_buttons" string="Scan Available Buttons"
                            type="object" class="oe_highlight"
                            invisible="not model_id"/>
                    <button name="action_test_rule" string="Test Rule"
                            type="object"
                            invisible="not model_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Rule Name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Hide Approve Button from Officers"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="model_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="model_name" readonly="1"/>
                            <field name="view_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Button">
                            <field name="button_name"
                                   widget="button_selector"/>
                            <field name="button_string" readonly="1"/>
                            <field name="mode"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Groups">
                        <field name="group_ids"
                               nolabel="1"
                               widget="many2many_tags"/>
                    </group>
                    <group string="Company">
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── List View ─────────────────────────────────────────────── -->
    <record id="view_el_button_access_rule_list" model="ir.ui.view">
        <field name="name">el.button.access.rule.list</field>
        <field name="model">el.button.access.rule</field>
        <field name="arch" type="xml">
            <list string="Button Access Rules"
                  decoration-success="mode == 'show_only'"
                  decoration-danger="mode == 'hide_from'"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="view_type"/>
                <field name="button_name"/>
                <field name="mode"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ─── Search View ───────────────────────────────────────────── -->
    <record id="view_el_button_access_rule_search" model="ir.ui.view">
        <field name="name">el.button.access.rule.search</field>
        <field name="model">el.button.access.rule</field>
        <field name="arch" type="xml">
            <search string="Search Button Access Rules">
                <field name="name"/>
                <field name="model_id"/>
                <field name="button_name"/>
                <field name="group_ids"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <filter name="filter_show_only" string="Whitelist (Show Only)"
                        domain="[('mode', '=', 'show_only')]"/>
                <filter name="filter_hide_from" string="Blacklist (Hide From)"
                        domain="[('mode', '=', 'hide_from')]"/>
                <group>
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model_id'}"/>
                    <filter name="group_view_type" string="View Type"
                            context="{'group_by': 'view_type'}"/>
                    <filter name="group_mode" string="Mode"
                            context="{'group_by': 'mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ────────────────────────────────────────────────── -->
    <record id="action_el_button_access_rule" model="ir.actions.act_window">
        <field name="name">Button Access Rules</field>
        <field name="res_model">el.button.access.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first button access rule
            </p>
            <p>
                Control which buttons appear or disappear for specific user groups
                in any Odoo view — without editing XML.
            </p>
            <p>
                <b>Whitelist mode:</b> Show a button only to selected groups.<br/>
                <b>Blacklist mode:</b> Hide a button from selected groups.
            </p>
        </field>
    </record>

</odoo>
