<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_construction_project" model="ir.sequence">
            <field name="name">Construction Project</field>
            <field name="code">el_construction.project</field>
            <field name="prefix">PRJ/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_sub_project" model="ir.sequence">
            <field name="name">Construction Sub Project</field>
            <field name="code">el_construction.sub.project</field>
            <field name="prefix">SPRJ/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_boq" model="ir.sequence">
            <field name="name">Bill of Quantities</field>
            <field name="code">el_construction.boq</field>
            <field name="prefix">BOQ/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_rate_analysis" model="ir.sequence">
            <field name="name">Rate Analysis</field>
            <field name="code">el_construction.rate.analysis</field>
            <field name="prefix">ANLY/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_budget" model="ir.sequence">
            <field name="name">Construction Budget</field>
            <field name="code">el_construction.budget</field>
            <field name="prefix">BDG/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_phase" model="ir.sequence">
            <field name="name">Construction Phase</field>
            <field name="code">el_construction.phase</field>
            <field name="prefix">PHS/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_work_order" model="ir.sequence">
            <field name="name">Construction Work Order</field>
            <field name="code">el_construction.work.order</field>
            <field name="prefix">WO/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_material_requisition" model="ir.sequence">
            <field name="name">Material Requisition</field>
            <field name="code">el_construction.material.requisition</field>
            <field name="prefix">MREQ/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_subcontract" model="ir.sequence">
            <field name="name">Construction Subcontract</field>
            <field name="code">el_construction.subcontract</field>
            <field name="prefix">CSJ/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_consume_order" model="ir.sequence">
            <field name="name">Consume Order</field>
            <field name="code">el_construction.consume.order</field>
            <field name="prefix">MCS/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_construction_ra_billing" model="ir.sequence">
            <field name="name">RA Billing</field>
            <field name="code">el_construction.ra.billing</field>
            <field name="prefix">RAB/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_progress_billing" model="ir.sequence">
            <field name="name">Progress Billing</field>
            <field name="code">el_construction.progress.billing</field>
            <field name="prefix">PB/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_quality_check" model="ir.sequence">
            <field name="name">Quality Check</field>
            <field name="code">el_construction.quality.check</field>
            <field name="prefix">QC/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_task" model="ir.sequence">
            <field name="name">Construction Task</field>
            <field name="code">el_construction.task</field>
            <field name="prefix">TSK/</field>
            <field name="padding">4</field>
        </record>

        <record id="seq_construction_extra_expense" model="ir.sequence">
            <field name="name">Extra Expense</field>
            <field name="code">el_construction.extra.expense</field>
            <field name="prefix">EXP/</field>
            <field name="padding">4</field>
        </record>
    
        <record id="seq_construction_variation_order" model="ir.sequence"><field name="name">Variation Order</field><field name="code">el_construction.variation.order</field><field name="prefix">VO/</field><field name="padding">4</field></record>
        <record id="seq_construction_ncr" model="ir.sequence"><field name="name">Non-Conformance Report</field><field name="code">el_construction.ncr</field><field name="prefix">NCR/</field><field name="padding">4</field></record>
    <record id="seq_construction_material_issue" model="ir.sequence">
        <field name="name">Construction Material Stock Operation</field>
        <field name="code">el_construction.material.issue</field>
        <field name="prefix">MSO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</data>
</odoo>
