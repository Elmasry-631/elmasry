<odoo>
    <record id="view_construction_material_issue_list" model="ir.ui.view">
        <field name="name">el_construction.material.issue.list</field>
        <field name="model">el_construction.material.issue</field>
        <field name="arch" type="xml">
            <list string="Material Stock Operations">
                <field name="name" />
                <field name="issue_type" />
                <field name="project_id" />
                <field name="sub_project_id" />
                <field name="material_requisition_id" />
                <field name="warehouse_id" />
                <field name="source_location_id" />
                <field name="destination_location_id" />
                <field name="date" />
                <field name="actual_cost" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>
    <record id="view_construction_material_issue_form" model="ir.ui.view">
        <field name="name">el_construction.material.issue.form</field>
        <field name="model">el_construction.material.issue</field>
        <field name="arch" type="xml">
            <form string="Material Stock Operation" class="o_construction_form">
                <header>
                    <button name="action_confirm" string="Create Stock Operation" type="object" class="oe_highlight" invisible="state != 'draft'" />
                    <button name="action_done" string="Validate" type="object" class="oe_highlight" invisible="state != 'confirmed'" />
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')" />
                    <button name="action_view_stock_document" string="Open Stock Document" type="object" invisible="state not in ('confirmed', 'done') or (not picking_id and not scrap_id)" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group string="Schedule &amp; Responsibility" class="o_construction_section">
                        <group>
                            <field name="issue_type" />
                            <field name="project_id" />
                            <field name="sub_project_id" />
                            <field name="work_order_id" />
                            <field name="task_id" />
                        </group>
                        <group>
                            <field name="material_requisition_id" />
                            <field name="warehouse_id" />
                            <field name="source_location_id" />
                            <field name="destination_location_id" />
                            <field name="date" />
                        </group>
                    </group>
                    <group string="Odoo Stock Document">
                        <field name="picking_id" readonly="1" />
                        <field name="scrap_id" readonly="1" />
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="material_requisition_line_id" />
                            <field name="product_id" />
                            <field name="description" />
                            <field name="quantity" />
                            <field name="uom_id" />
                            <field name="available_qty" readonly="1" />
                        </list>
                    </field>
                    <field name="notes" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="view_construction_material_issue_search" model="ir.ui.view">
        <field name="name">el_construction.material.issue.search</field>
        <field name="model">el_construction.material.issue</field>
        <field name="arch" type="xml">
            <search string="Material Stock Operations">
                <field name="name" />
                <field name="project_id" />
                <field name="material_requisition_id" />
                <filter name="issue" string="Issue" domain="[('issue_type', '=', 'issue')]" />
                <filter name="consume" string="Consumption" domain="[('issue_type', '=', 'consume')]" />
                <filter name="return" string="Returns" domain="[('issue_type', '=', 'return')]" />
                <filter name="wastage" string="Wastage" domain="[('issue_type', '=', 'wastage')]" />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}" />
                    <filter name="group_type" string="Operation Type" context="{'group_by': 'issue_type'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_material_issue" model="ir.actions.act_window">
        <field name="name">Material Stock Operations</field>
        <field name="res_model">el_construction.material.issue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>