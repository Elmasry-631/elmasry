<odoo>
    <record id="view_construction_work_type_list" model="ir.ui.view">
        <field name="name">el_construction.work.type.list</field>
        <field name="model">el_construction.work.type</field>
        <field name="arch" type="xml">
            <list string="Work Types" editable="bottom">
                <field name="name" />
                <field name="code" />
                <field name="description" />
            </list>
        </field>
    </record>
    <record id="view_construction_work_type_form" model="ir.ui.view">
        <field name="name">el_construction.work.type.form</field>
        <field name="model">el_construction.work.type</field>
        <field name="arch" type="xml">
            <form string="Work Type" class="o_construction_form">
                <sheet>
                    <group string="Configuration" class="o_construction_section">
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                    <field name="sub_type_ids">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="code" />
                            <field name="description" />
                            <field name="active" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_construction_work_type" model="ir.actions.act_window">
        <field name="name">Work Types</field>
        <field name="res_model">el_construction.work.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_construction_work_sub_type_list" model="ir.ui.view">
        <field name="name">el_construction.work.sub.type.list</field>
        <field name="model">el_construction.work.sub.type</field>
        <field name="arch" type="xml">
            <list string="Work Sub Types" editable="bottom">
                <field name="work_type_id" />
                <field name="name" />
                <field name="code" />
                <field name="description" />
            </list>
        </field>
    </record>
    <record id="action_construction_work_sub_type" model="ir.actions.act_window">
        <field name="name">Work Sub Types</field>
        <field name="res_model">el_construction.work.sub.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>