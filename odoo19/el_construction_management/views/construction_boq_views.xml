<odoo>
    <record id="view_construction_boq_list" model="ir.ui.view">
        <field name="name">el_construction.boq.list</field>
        <field name="model">el_construction.boq</field>
        <field name="arch" type="xml">
            <list string="Bill of Quantities">
                <field name="name" />
                <field name="project_id" readonly="state != 'draft'" />
                <field name="sub_project_id" readonly="state != 'draft'" />
                <field name="work_type_id" readonly="state != 'draft'" />
                <field name="work_sub_type_id" readonly="state != 'draft'" />
                <field name="quantity" />
                <field name="total_amount" sum="Total" />
            </list>
        </field>
    </record>
    <record id="view_construction_boq_form" model="ir.ui.view">
        <field name="name">el_construction.boq.form</field>
        <field name="model">el_construction.boq</field>
        <field name="arch" type="xml">
            <form string="Bill of Quantities" class="o_construction_form">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'approved')"/>
                    <button name="action_lock" string="Lock" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,locked,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group string="Project Context" class="o_construction_section">
                        <group>
                            <field name="project_id" readonly="state != 'draft'" />
                            <field name="sub_project_id" readonly="state != 'draft'" />
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="work_type_id" readonly="state != 'draft'" />
                            <field name="work_sub_type_id" readonly="state != 'draft'" />
                            <field name="uom_id" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group string="Measurement (Length x Width x Height x Nos)">
                        <group>
                            <field name="length" readonly="state != 'draft'" />
                            <field name="width" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="height" readonly="state != 'draft'" />
                            <field name="nos" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="quantity" />
                        </group>
                    </group>
                    <separator string="Description" />
                    <field name="description" readonly="state != 'draft'" />
                    <separator string="BOQ Lines" />
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id" />
                            <field name="description" readonly="state != 'draft'" />
                            <field name="quantity" />
                            <field name="uom_id" readonly="state != 'draft'" />
                            <field name="unit_price" />
                            <field name="amount" sum="Total" />
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_amount" class="oe_subtotal_footer_separator" />
                    </group>
                    <div class="oe_clear" />
                    <button name="action_create_budget" string="Create / Update Budget" type="object" class="oe_highlight" icon="fa-calculator" invisible="state != 'draft'" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="view_construction_boq_search" model="ir.ui.view">
        <field name="name">el_construction.boq.search</field>
        <field name="model">el_construction.boq</field>
        <field name="arch" type="xml">
            <search string="Bill of Quantities">
                <field name="name" />
                <field name="project_id" readonly="state != 'draft'" />
                <field name="sub_project_id" readonly="state != 'draft'" />
                <field name="work_type_id" readonly="state != 'draft'" />
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}" />
                    <filter name="group_work_type" string="Work Type" context="{'group_by': 'work_type_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_boq" model="ir.actions.act_window">
        <field name="name">Bill of Quantities</field>
        <field name="res_model">el_construction.boq</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Bill of Quantities
            </p>
        </field>
    </record>
</odoo>