<odoo>
    <record id="view_construction_report_wizard_form" model="ir.ui.view">
        <field name="name">el_construction.report.wizard.form</field>
        <field name="model">el_construction.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Construction Report Center" class="o_construction_form">
                <sheet>
                    <div class="oe_title">
                        <h1>Construction Report Center</h1>
                    </div>
                    <group string="Project Context" class="o_construction_section">
                        <group>
                            <field name="report_type" />
                            <field name="output_format" widget="radio" />
                        </group>
                        <group>
                            <field name="project_id" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="include_archived" />
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Select the report, optional project/date filters, and the output format. PDF uses the full Construction report design; Excel exports a structured data sheet.
                    </div>
                </sheet>
                <footer>
                    <button name="action_print" string="Generate Report" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_construction_report_center" model="ir.actions.act_window">
        <field name="name">Construction Report Center</field>
        <field name="res_model">el_construction.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>