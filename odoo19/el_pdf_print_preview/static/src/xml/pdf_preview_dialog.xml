<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="el_pdf_print_preview.PDFPreviewDialog">
        <Dialog t-props="{title: dialogTitle, size: 'xl'}">
            <div class="o_pdf_preview_dialog">
                <iframe t-ref="iframe"
                        style="width:100%; height:75vh; border:0; border-radius:4px;"
                        allowfullscreen="allowfullscreen"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="onClose">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

</templates>
