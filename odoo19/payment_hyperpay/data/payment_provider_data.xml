<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_hyperpay" model="payment.provider">
        <field name="name">HyperPay</field>
        <field name="code">hyperpay</field>
        <field name="state">disabled</field>
        <field name="is_published">False</field>
        <field name="redirect_form_view_id" ref="hyperpay_form"/>
        <field name="module_id" ref="base.module_payment_hyperpay"/>
        <field name="hyperpay_authorization">dummy</field>
        <field name="hyperpay_merchant_id">dummy</field>
        <field name="pre_msg"><![CDATA[
            <div>Configure your HyperPay credentials in test or enabled mode.</div>
            <div>Test card: 4200000000000000</div>
            <div>CVV: any 3 digits</div>
            <div>Expiry Date: any future date</div>
        ]]></field>
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment_hyperpay.payment_method_hyperpay')])]"/>
    </record>

</odoo>
