<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_hyperpay" model="ir.ui.view">
        <field name="name">payment.provider.form.hyperpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'hyperpay'">
                    <field name="hyperpay_merchant_id"
                           required="code == 'hyperpay' and state != 'disabled'"/>
                    <field name="hyperpay_authorization"
                           required="code == 'hyperpay' and state != 'disabled'"
                           password="True"/>
                    <field name="hyperpay_data_brands"
                           required="code == 'hyperpay' and state != 'disabled'"
                           placeholder="VISA MASTER MADA"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
