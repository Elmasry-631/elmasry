<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_direct_print" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.direct.print</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Add Direct Print button to the form header (statusbar area).
                     Always visible per STEP 0 confirmation. -->
                <xpath expr="//header" position="inside">
                    <button name="action_direct_print"
                            type="object"
                            string="Direct Print"
                            class="oe_highlight"
                            icon="fa-print"
                            groups="direct_print_auto.group_direct_print_user"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
