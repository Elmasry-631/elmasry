<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_direct_print" model="ir.module.category">
            <field name="name">Direct Print</field>
            <field name="sequence">20</field>
        </record>

        <record id="res_groups_privilege_direct_print" model="res.groups.privilege">
            <field name="name">Direct Print</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="module_category_direct_print"/>
        </record>

        <record id="group_direct_print_user" model="res.groups">
            <field name="name">Direct Print User</field>
            <field name="privilege_id" ref="res_groups_privilege_direct_print"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_direct_print_manager" model="res.groups">
            <field name="name">Direct Print Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_direct_print"/>
            <field name="implied_ids" eval="[(4, ref('group_direct_print_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
