<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_daily_sequence.ReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('cashier')]" position="after">
            <div t-if="order.dailyOrderNumberOnly"
                 class="pos-receipt-daily-order-number"
                 style="font-weight: 700; font-size: 40px; line-height: 1.1;">
                <t t-esc="order.dailyOrderNumberOnly"/>
            </div>
        </xpath>
    </t>
</templates>
