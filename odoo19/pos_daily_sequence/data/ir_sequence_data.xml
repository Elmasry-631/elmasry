<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Default POS Daily Sequence
        This is a template sequence that will be used as a reference.
        Each POS config creates its own sequence when daily sequence is enabled.
    -->
    <record id="sequence_pos_daily_order" model="ir.sequence">
        <field name="name">POS Daily Order - Default Template</field>
        <field name="code">pos.daily.order</field>
        <field name="prefix">POS-%(year)s%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range">1</field>
        <field name="active">True</field>
    </record>

</odoo>
