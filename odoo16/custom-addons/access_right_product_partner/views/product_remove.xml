<odoo>


    <!-- Inherit Form View to Modify it -->
    <record id="sale_inherit_form_profuct" model="ir.ui.view">
        <field name="name">sale_inherit_form_profuct</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page/field[@name='order_line']/tree/field[@name='product_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>

        </field>
    </record>
    <record id="purchase_inherit_form_product" model="ir.ui.view">
        <field name="name">purchase_inherit_form_product</field>
        <field name="model">purchase.order</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page/field[@name='order_line']/tree/field[@name='product_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>

        </field>
    </record>
    <record id="invoice_inherit_form_profuct" model="ir.ui.view">
        <field name="name">invoice_inherit_form_profuct</field>
        <field name="model">account.move</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>
            <xpath expr="//notebook/page/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>

        </field>
    </record>
    <record id="stock_picking_inherit_form_profuct" model="ir.ui.view">
        <field name="name">stock_picking_inherit_form_profuct</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='partner_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>
            <xpath expr="//notebook/page[2]/field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="attributes">

                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>

            </xpath>

        </field>
    </record>
