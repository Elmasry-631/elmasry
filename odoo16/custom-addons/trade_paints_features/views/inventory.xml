        <record id="view_picking_tree_inherit_trade" model="ir.ui.view">
            <field name="name">trade.view.picking.tree.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">

                <xpath expr="//tree" position="attributes">
                    <attribute name="decoration-success">state == 'done' and printed_before == False </attribute>
                    <attribute name="decoration-primary">printed_before == True</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="total_weight" sum="total_weight" string="Total weight (Kg)"/>
                    <field name="printed_before" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>