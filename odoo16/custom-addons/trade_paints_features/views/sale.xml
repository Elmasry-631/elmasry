		<!-- First Record -->
		<record id="sale_view_order_form_inherited_all_leads" model="ir.ui.view">
			<field name="name">sale.order.form.inherited1</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form" />
			<field name="arch" type="xml">
				<!-- Apply groups attribute to individual fields -->
				<field name="pricelist_id" position="attributes" groups="sales_team.group_sale_salesman_all_leads">
					<attribute name="readonly">0</attribute>
				</field>
				<field name="payment_term_id" position="attributes" groups="sales_team.group_sale_salesman_all_leads">
					<attribute name="readonly">0</attribute>
				</field>
				<xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="attributes" groups="sales_team.group_sale_salesman_all_leads">
					<attribute name="readonly">0</attribute>
				</xpath>
				<xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="attributes" groups="sales_team.group_sale_salesman_all_leads">
					<attribute name="readonly">0</attribute>
				</xpath>
			</field>
		</record>

		<!-- Second Record -->
		<record id="view_sale_oder_form_inherit_trade_quota" model="ir.ui.view">
			<field name="name">trade.view.sale.order.inherit.quota</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='sale_order_option_ids']" position="attributes" groups="sales_team.group_sale_salesman_all_leads">
					<!-- groups attribute is already correctly placed here -->
				</xpath>
			</field>
		</record>

		<!-- Third Record -->
		<record id="res_partner_view_products_button" model="ir.ui.view">
			<field name="name">res.partner.view.product.buttons</field>
			<field name="model">res.partner</field>
			<field name="inherit_id" ref="base.view_partner_form" />
			<field name="arch" type="xml">
				<div class="oe_button_box" name="button_box" position="inside">
					<button class="oe_stat_button" name="get_products_for_vendor" type="object"
							icon="fa-shopping-cart" context="{'partner_id':active_id}" string="Products">
					</button>
				</div>
			</field>
		</record>




    </data>
</odoo>