<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
		<record model="ir.ui.view" id="sale_quotation_weight_tree_trade_inherited">
			<field name="name">sale.quotation.weight.view.tree</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_quotation_tree"/>
			<field name="arch" type="xml">
			     <xpath expr="//field[@name='amount_total']" position="after">
                    <field name="weigh_total"/>
                </xpath>
			</field>
		</record>
        <record id="sale_order_view_tree_tradepaints_inherit" model="ir.ui.view">
            <field name="name">sale.order.tree</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <field name="amount_total" position="after">
                    <field name="weigh_total"/>
                </field>
            </field>
        </record>
    
        <menuitem id="sale.menu_sale_quotations"
                action="sale.action_quotations_with_onboarding"
                parent="sale.sale_order_menu"
                sequence="1" groups="trade_paint_quotation_menu"/>

        <menuitem action="purchase.purchase_rfq" id="purchase.menu_purchase_rfq"
            parent="purchase.menu_procurement_management"
            groups="trade_paints_features.trade_paint_rfq_menu"
            sequence="0"/>

        <record id="view_sale_oder_form_inherit_trade" model="ir.ui.view">
            <field name="name">trade.view.sale.order.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//tree//field[@name='price_subtotal']" position="after">
                    <field name="qty_available" string="المخزون" class="bg-success"/>
                    <field name="product_weight" string="وزن البضاعة"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//tree//control" position="replace">
                    <control>
                    </control>
                </xpath>
                <field name="tax_totals" position="before">
                    <field name="weigh_total" string="اجمالي البضاعة"/>
                </field>
                <field name="tax_totals" position="before">
                    <field name="discount_tot_for_lines" string="Lines Discount Total"/>
                </field>
                    <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
		
		
