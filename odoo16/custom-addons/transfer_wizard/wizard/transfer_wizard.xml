<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
      <record model="ir.ui.view" id="transfer_wizard_transfer_wizard_view">
          <field name="name">transfer.wizard.form.view</field>
          <field name="model">transfer.wizard</field>
          <field name="arch" type="xml">
            <form>
                <group>
                  <field name="expected_weight"/>
                  <field name="driver_name" string="اسم السائق" />
                  <field name="car_number" string="رقم السيارة "/>
                </group>
                <footer>
                  <button name="validate" string="Validate" type="object" class="oe_highlight" confirm="Are you sure ?"/>
                  or
                  <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
          </field>
      </record>
      <record model="ir.actions.server" id="server_action_transfer_wizard_transfer_wizard_view">
          <field name="name">Transfer Trade</field>
          <field name="model_id" ref="stock.model_stock_picking" />
          <field name="binding_model_id" ref="stock.model_stock_picking" />
          <field name="state">code</field>
          <field name="code">
          action = {
            'type': 'ir.actions.act_window',
            'res_model': 'transfer.wizard',
            'target': 'new',
            'views': [(env.ref('transfer_wizard.transfer_wizard_transfer_wizard_view').id,'form')],
            'context': {},

          }
          </field>
      </record>
    </data>
</odoo>