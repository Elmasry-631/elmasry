<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dashboard Item Configuration Wizard View -->
        <record id="view_dashboard_item_config_wizard_form" model="ir.ui.view">
            <field name="name">dashboard.builder.item.config.wizard.form</field>
            <field name="model">dashboard.builder.item.config.wizard</field>
            <field name="arch" type="xml">
                <form string="Configure Widget">
                    <header>
                        <button name="action_save" string="Save" type="object" class="btn-primary"/>
                        <button name="action_reset" string="Reset to Defaults" type="object" class="btn-secondary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </header>
                    <sheet>
                        <group string="Widget" col="2">
                            <field name="widget_id" readonly="1"/>
                            <field name="item_id" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="Configuration" name="config">
                                <group string="Widget Schema" col="1">
                                    <field name="config_schema" widget="json" options="{'mode': 'code'}" readonly="1"/>
                                </group>
                                <group string="Current Configuration" col="1">
                                    <field name="config" widget="json" options="{'mode': 'code'}"/>
                                </group>
                            </page>
                            <page string="Advanced" name="advanced">
                                <group string="Filters" col="1">
                                    <field name="item_id" invisible="1"/>
                                    <field name="config" widget="json" options="{'mode': 'code'}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_dashboard_item_config_wizard" model="ir.actions.act_window">
            <field name="name">Configure Widget</field>
            <field name="res_model">dashboard.builder.item.config.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>