<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_form_inherit_el_stock_no_negative" model="ir.ui.view">
        <field name="name">stock.quant.form.inherit.el_stock_no_negative</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="allow_negative_stock" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_inherit_el_stock_no_negative" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.el_stock_no_negative</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="after">
                <field name="allow_negative_stock" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>