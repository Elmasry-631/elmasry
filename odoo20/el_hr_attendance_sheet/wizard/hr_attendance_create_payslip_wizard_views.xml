<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_create_payslip_wizard_form" model="ir.ui.view">
        <field name="name">hr.attendance.create.payslip.wizard.form</field>
        <field name="model">hr.attendance.create.payslip.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Payslip From Attendance Sheet">
                <group>
                    <group>
                        <field name="sheet_id" readonly="True"/>
                        <field name="employee_id" readonly="True"/>
                        <field name="contract_id" readonly="True"/>
                    </group>
                    <group>
                        <field name="date_from" readonly="True"/>
                        <field name="date_to" readonly="True"/>
                        <field name="struct_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_payslip" string="Create Payslip"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_create_payslip_wizard" model="ir.actions.act_window">
        <field name="name">Create Payslip</field>
        <field name="res_model">hr.attendance.create.payslip.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
