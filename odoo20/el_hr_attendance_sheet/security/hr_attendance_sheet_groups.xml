<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege for Odoo 19+ (replaces category_id) -->
    <record id="module_privilege_hr_attendance_sheet" model="res.groups.privilege">
        <field name="name">Attendance Sheets</field>
        <field name="description">Manage attendance sheets, policies and rules</field>
    </record>

    <!-- ============ GROUPS ============ -->
    <record id="group_hr_attendance_sheet_user" model="res.groups">
        <field name="name">Attendance Sheet User</field>
        <field name="privilege_id" ref="module_privilege_hr_attendance_sheet"/>
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <record id="group_hr_attendance_sheet_officer" model="res.groups">
        <field name="name">Attendance Sheet Officer</field>
        <field name="privilege_id" ref="module_privilege_hr_attendance_sheet"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_attendance_sheet_user'))]"/>
    </record>

    <record id="group_hr_attendance_sheet_manager" model="res.groups">
        <field name="name">Attendance Sheet Manager</field>
        <field name="privilege_id" ref="module_privilege_hr_attendance_sheet"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_attendance_sheet_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
